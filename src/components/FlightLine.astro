<aside class="flight-line" aria-hidden="true">
  <span class="flight-line__label">TRAJECTOIRE / ROUND</span>
  <svg viewBox="0 0 64 640" role="presentation">
    <path class="flight-line__base" d="M32 2V160C32 212 9 224 9 276V401C9 450 55 458 55 510V638" />
    <path class="flight-line__progress" pathLength="1" d="M32 2V160C32 212 9 224 9 276V401C9 450 55 458 55 510V638" />
    <rect x="9" y="540" width="46" height="78" rx="1" />
    <line x1="9" y1="562" x2="55" y2="562" />
    <line x1="9" y1="588" x2="55" y2="588" />
  </svg>
  <span class="flight-line__round" data-round>01 / 04</span>
</aside>

<style>
  /* Colour is resolved from html[data-tone], set by the header's surface
     tracker. Previously mix-blend-mode: difference, which forced the whole
     document into one composited layer. */
  .flight-line {
    position: fixed;
    z-index: 45;
    top: calc(var(--header-height) + 1rem);
    right: max(0.55rem, calc((100vw - var(--max)) / 2 + 0.55rem));
    bottom: 1rem;
    width: 2.8rem;
    pointer-events: none;
    color: var(--signal);
    --line-progress: var(--flight);
    transition: color 240ms ease;
  }

  :global(html[data-tone='light']) .flight-line {
    color: color-mix(in srgb, var(--ink) 52%, transparent);
    --line-progress: var(--signal);
  }

  :global(html[data-tone='signal']) .flight-line {
    color: color-mix(in srgb, var(--ink) 62%, transparent);
    --line-progress: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .flight-line {
      transition: none;
    }
  }

  .flight-line svg {
    width: 100%;
    height: calc(100% - 4rem);
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .flight-line__base {
    opacity: 0.2;
  }

  .flight-line__progress {
    stroke: var(--line-progress);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--progress));
  }

  .flight-line__label,
  .flight-line__round {
    position: absolute;
    left: 50%;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .flight-line__label {
    top: 7.5rem;
    transform: rotate(90deg) translateX(-50%);
    transform-origin: left top;
  }

  .flight-line__round {
    bottom: 0;
    transform: translateX(-50%);
  }

  @media (max-width: 64rem) {
    .flight-line {
      right: 0.25rem;
      width: 1.75rem;
      opacity: 0.74;
    }

    .flight-line__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flight-line__progress {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const round = document.querySelector<HTMLElement>('[data-round]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const updateFlightLine = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    root.style.setProperty('--progress', reduceMotion ? '1' : progress.toFixed(4));
    if (round) {
      const current = Math.min(4, Math.floor(progress * 4) + 1);
      round.textContent = `${String(current).padStart(2, '0')} / 04`;
    }
  };

  let ticking = false;
  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(() => {
      updateFlightLine();
      ticking = false;
    });
  };

  updateFlightLine();
  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
</script>
