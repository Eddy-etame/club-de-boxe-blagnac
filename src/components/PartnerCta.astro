---
/**
 * The network block.
 *
 * The Club de Boxe Blagnac belongs to the Boxing Center network and says so.
 * Which clubs, and which of their pages, appear depends on the page — PICKS
 * in src/data/network.ts decides; this component only renders. A parent on
 * the baby boxing page is sent to the network's children pages; a visitor on
 * the access page to the network's access pages.
 *
 * Framing matters: "if this one is closer to you, go and see them" reads as
 * a club with a network; "ask them, they know" reads as a club that does not
 * exist.
 */
import { NETWORK, NETWORK_CLUBS, PICKS } from '@/data/network';

interface Props {
  /** Key into PICKS: 'home', 'hub', 'first', 'faq', 'access' or a course slug. */
  context: string;
  /** Eyebrow above the heading. */
  eyebrow?: string;
  /** Headline. Should name what the visitor gets by clicking through. */
  heading: string;
  /** One sentence of setup. */
  intro: string;
  /** Ink surface by default; `light` sits on paper. */
  tone?: 'dark' | 'light';
}

const { context, eyebrow = 'Réseau ' + NETWORK.name, heading, intro, tone = 'dark' } = Astro.props;
const pick = PICKS[context] ?? PICKS.home;
const cards = pick.clubs.flatMap((p) => {
  const club = NETWORK_CLUBS.find((c) => c.id === p.id);
  if (!club) return [];
  const links = p.topics.flatMap((t) => {
    const link = club.links[t];
    return link ? [link] : [];
  });
  return [{ club, links }];
});
---

<section class:list={['partner-cta', tone === 'dark' && 'surface-dark']} aria-labelledby="partner-cta-title">
  <div class="shell">
    <div class="section-heading">
      <p class="eyebrow eyebrow--signal">{eyebrow}</p>
      <div>
        <h2 id="partner-cta-title">{heading}</h2>
        <p class="section-heading__intro">{intro}</p>
      </div>
    </div>

    <div class="partner-cta__list sequence-reveal">
      {cards.map(({ club, links }) => (
        <article class="partner-cta__card">
          <p class="partner-cta__short">{club.short}</p>
          <h3><a href={club.url} rel="noopener">{club.name}</a></h3>
          <p class="partner-cta__area">{club.area}</p>
          <p class="partner-cta__pitch">{club.pitch}</p>
          {links.length > 0 && (
            <ul class="partner-cta__links">
              {links.map((l) => (
                <li><a href={l.url} rel="noopener">{l.label} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    <div class="partner-cta__network">
      <p>
        Le Club de Boxe Blagnac fait partie du réseau <a href={NETWORK.url} rel="noopener">{NETWORK.name}</a>.
      </p>
      <ul>
        {pick.extras.map((l) => (
          <li><a href={l.url} rel="noopener">{l.label} <span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .partner-cta {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .partner-cta__list {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .partner-cta__card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.4rem, 2.6vw, 2.2rem);
    border: 1px solid var(--line);
    transition: border-color 260ms ease;
  }

  .partner-cta__card:hover {
    border-color: currentColor;
  }

  .partner-cta__short {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .partner-cta__card h3 {
    font-size: clamp(1.45rem, 2.4vw, 2.1rem);
    font-variation-settings: 'wdth' 84, 'wght' 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .partner-cta__card h3 a {
    text-decoration: none;
  }

  .partner-cta__card h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .partner-cta__area {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    line-height: 1.7;
    opacity: 0.68;
    text-transform: uppercase;
  }

  .partner-cta__pitch {
    max-width: 46ch;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .partner-cta__links,
  .partner-cta__network ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner-cta__links {
    margin-top: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .partner-cta__links a,
  .partner-cta__network ul a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .partner-cta__links a span,
  .partner-cta__network ul a span {
    transition: transform 180ms ease;
  }

  .partner-cta__links a:hover span,
  .partner-cta__network ul a:hover span {
    transform: translateX(0.35rem);
  }

  .partner-cta__links a:hover,
  .partner-cta__network ul a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .partner-cta__network {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .partner-cta__network > p {
    max-width: 52ch;
    font-size: 1rem;
  }

  .partner-cta__network > p a {
    text-underline-offset: 0.2em;
  }
</style>
