---
/**
 * Visible breadcrumb. BaseLayout passes the SAME trail to this component and
 * to the BreadcrumbList in the page graph, so what a visitor reads and what a
 * crawler reads can never disagree.
 *
 * It sits in the hero's top margin, under the fixed header, so no page
 * template has to make room for it.
 */
interface Props {
  trail: { name: string; path: string }[];
}

const { trail } = Astro.props;
---

<nav class="crumbs shell" aria-label="Fil d’Ariane">
  <ol>
    <li><a href="/">Accueil</a></li>
    {trail.map((c, i) => (
      <li>
        {i === trail.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    position: absolute;
    z-index: 2;
    top: calc(var(--header-height) + 1.25rem);
    right: 0;
    left: 0;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .crumbs li + li::before {
    content: '/';
    opacity: 0.5;
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--paper-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .crumbs [aria-current] {
    color: var(--paper-bright);
  }
</style>
