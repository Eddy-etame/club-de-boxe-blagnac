---
import { NAV, SITE } from '@/data/site';
import { CLUB, DISCIPLINES } from '@/data/club';
import { NETWORK, NETWORK_CLUBS } from '@/data/network';
---

<footer class="site-footer surface-dark">
  <div class="site-footer__inner shell">
    <div class="site-footer__lead">
      <p class="eyebrow eyebrow--signal">Réseau {NETWORK.name} · Blagnac</p>
      <p class="site-footer__title">Le prochain round<br />commence par un message.</p>
      <a class="button" href="/acces-contact/#contact">Nous écrire</a>
    </div>

    <div class="site-footer__grid">
      <nav aria-label="Navigation secondaire">
        <p class="site-footer__label">Parcours</p>
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Nos cours de boxe à Blagnac">
        <p class="site-footer__label">Nos cours</p>
        <ul>
          {DISCIPLINES.map((d) => <li><a href={'/cours-de-boxe-blagnac/' + d.slug + '/'}>{d.linkLabel}</a></li>)}
        </ul>
      </nav>

      <nav aria-label={'Clubs du réseau ' + NETWORK.name}>
        <p class="site-footer__label">Réseau {NETWORK.name}</p>
        <ul>
          {NETWORK_CLUBS.map((c) => <li><a href={c.url} rel="noopener">{c.name}</a></li>)}
          <li><a href={NETWORK.url} rel="noopener">Le réseau {NETWORK.name}</a></li>
        </ul>
      </nav>

      <div>
        <p class="site-footer__label">Transparence</p>
        <ul>
          <li><a href="/faq/">Questions fréquentes</a></li>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/confidentialite/">Confidentialité</a></li>
        </ul>
      </div>

      <p class="site-footer__status">
        Club de boxe anglaise à Blagnac (31700), membre du réseau {NETWORK.name}. Six cours, du baby boxing dès 3 ans au groupe compétition. {CLUB.openLine}
      </p>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>Blagnac · Toulouse nord-ouest</span>
      <a href="#top">Retour en haut ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(5rem, 10vw, 10rem) 1.5rem;
  }

  .site-footer__lead {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding-bottom: clamp(4rem, 9vw, 9rem);
  }

  .site-footer__title {
    max-width: 12ch;
    font-size: clamp(3rem, 9vw, 9rem);
    font-weight: 780;
    letter-spacing: -0.06em;
    line-height: 0.86;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.2rem 2rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 2rem;
    border-top: 1px solid rgb(255 255 255 / 24%);
  }

  .site-footer__label {
    margin-bottom: 1.1rem;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-underline-offset: 0.2em;
  }

  .site-footer__status {
    grid-column: 1 / -1;
    max-width: 44rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    font-size: clamp(1.05rem, 1.55vw, 1.35rem);
  }

  .site-footer__bottom {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto auto;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 24%);
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 60rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .site-footer__grid,
    .site-footer__bottom {
      grid-template-columns: 1fr;
    }
  }
</style>
