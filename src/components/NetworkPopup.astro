---
/**
 * Two small, dismissible prompts, modelled on the network sites' floating
 * "Une question ?" pastille and their mid-page promo block.
 *
 * 1. A slide-in card pointing to the network pages that match this page
 *    (POPUPS in src/data/network.ts). It opens once the visitor has read a
 *    real part of the page — 40 % scroll depth, never before 6 s — or after
 *    35 s, once per page type per session, and never while a form field has
 *    focus. It is non-modal: it neither steals focus nor covers the page,
 *    which keeps it clear of Google's intrusive-interstitial rules on mobile.
 * 2. A "Écrivez-nous" pill that follows the reader after the first screen,
 *    points at the form on this page when there is one, and steps aside
 *    whenever a form is on screen.
 *
 * Dismissal lives in sessionStorage only: nothing leaves the device, and the
 * privacy page says so.
 *
 * Motion rule of this codebase: the RESTING state is the visible one. The
 * entrance is an animation with fill-mode `both`, never a class that has to
 * arrive before the card becomes visible.
 */
import { NETWORK, POPUPS } from '@/data/network';

interface Props {
  /** Key into POPUPS: 'home', 'hub', 'first', 'faq', 'access' or a course slug. */
  context: string;
}

const { context } = Astro.props;
const pop = POPUPS[context];
---

{pop && (
  <aside
    class="net-pop"
    data-net-pop
    data-variant={context}
    role="dialog"
    aria-modal="false"
    aria-labelledby="net-pop-title"
    hidden
  >
    <button class="net-pop__close" type="button" data-net-pop-close aria-label="Fermer cet encart">
      <span aria-hidden="true">×</span>
    </button>
    <p class="net-pop__eyebrow">Réseau {NETWORK.name}</p>
    <p class="net-pop__title" id="net-pop-title">{pop.heading}</p>
    <p class="net-pop__text">{pop.text}</p>
    <ul class="net-pop__links">
      {pop.links.map((l) => (
        <li>
          <a href={l.url} rel="noopener" data-net-pop-link>{l.label} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </aside>
)}

<a class="contact-pill" href="/acces-contact/#contact" data-contact-pill hidden>
  <span class="contact-pill__dot" aria-hidden="true"></span>
  <span>Une question&nbsp;? <strong>Écrivez-nous</strong></span>
</a>

<script>
  const root = document.documentElement;
  const pop = document.querySelector<HTMLElement>('[data-net-pop]');
  const pill = document.querySelector<HTMLAnchorElement>('[data-contact-pill]');
  const KEY = pop ? 'cbb:network-card:' + (pop.dataset.variant || 'page') : '';
  const bornAt = performance.now();
  let opened = false;

  const store = {
    get(key: string) {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set(key: string) {
      try {
        sessionStorage.setItem(key, '1');
      } catch {
        /* Storage blocked: the card still closes, it just may come back. */
      }
    }
  };

  /* Point the pill at the form on this page when there is one. */
  const localSection = document
    .querySelector<HTMLElement>('#essai form, #contact form')
    ?.closest<HTMLElement>('section[id]');
  if (pill && localSection) pill.href = '#' + localSection.id;

  const visibleForms = new Set<Element>();
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visibleForms.add(e.target) : visibleForms.delete(e.target)));
        update();
      },
      { threshold: 0.05 }
    );
    document.querySelectorAll('form').forEach((f) => io.observe(f));
  }

  function depth() {
    const max = root.scrollHeight - window.innerHeight;
    return max > 0 ? window.scrollY / max : 1;
  }

  function typing() {
    const el = document.activeElement;
    return el instanceof HTMLElement && Boolean(el.closest('form'));
  }

  function openCard() {
    if (!pop || opened || store.get(KEY) || typing()) return;
    opened = true;
    pop.hidden = false;
    root.classList.add('net-pop-open');
  }

  function closeCard() {
    if (!pop || pop.hidden) return;
    store.set(KEY);
    root.classList.remove('net-pop-open');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    pop.classList.add('is-closing');
    window.setTimeout(() => {
      pop.hidden = true;
      pop.classList.remove('is-closing');
    }, reduce ? 0 : 240);
  }

  function update() {
    if (pill) pill.hidden = window.scrollY < window.innerHeight * 0.85 || visibleForms.size > 0;
    if (!opened && performance.now() - bornAt > 6000 && depth() > 0.4) openCard();
  }

  window.addEventListener('scroll', update, { passive: true });
  window.setTimeout(update, 6100);
  window.setTimeout(openCard, 35000);
  pop?.querySelector('[data-net-pop-close]')?.addEventListener('click', closeCard);
  pop?.querySelectorAll('[data-net-pop-link]').forEach((a) => a.addEventListener('click', () => store.set(KEY)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCard();
  });
  update();
</script>

<style>
  .net-pop {
    position: fixed;
    z-index: 40;
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    left: clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.7rem;
    width: min(24rem, calc(100vw - 1.5rem));
    max-height: min(32rem, 70svh);
    overflow: auto;
    padding: 1.3rem 1.3rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 18%);
    background: var(--ink, #141411);
    box-shadow: 0 1.2rem 3rem rgb(0 0 0 / 35%);
    color: var(--paper, #e8e5dc);
  }

  .net-pop:not([hidden]) {
    animation: net-pop-in 280ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .net-pop.is-closing {
    animation: net-pop-out 240ms ease both;
  }

  .net-pop[hidden] {
    display: none;
  }

  @keyframes net-pop-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes net-pop-out {
    to {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  .net-pop__close {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  .net-pop__close:focus-visible,
  .net-pop a:focus-visible,
  .contact-pill:focus-visible {
    outline: 2px solid var(--signal, #d7ff3a);
    outline-offset: 2px;
  }

  .net-pop__eyebrow {
    padding-right: 2.5rem;
    color: var(--signal, #d7ff3a);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .net-pop__title {
    padding-right: 1.5rem;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-variation-settings: 'wdth' 84, 'wght' 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .net-pop__text {
    font-size: 0.92rem;
    line-height: 1.5;
    opacity: 0.86;
  }

  .net-pop__links {
    display: grid;
    gap: 0.45rem;
    margin: 0.2rem 0 0;
    padding: 0.8rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 18%);
    list-style: none;
  }

  .net-pop__links a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .net-pop__links a span {
    color: var(--signal, #d7ff3a);
    transition: transform 180ms ease;
  }

  .net-pop__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .net-pop__links a:hover span {
    transform: translateX(0.3rem);
  }

  .contact-pill {
    position: fixed;
    z-index: 39;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    background: var(--signal, #d7ff3a);
    box-shadow: 0 0.6rem 1.8rem rgb(0 0 0 / 25%);
    color: var(--ink, #141411);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .contact-pill:not([hidden]) {
    animation: net-pop-in 240ms ease both;
  }

  .contact-pill[hidden] {
    display: none;
  }

  .contact-pill__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 40rem) {
    .net-pop {
      right: 0.5rem;
      bottom: 0.5rem;
      left: 0.5rem;
      width: auto;
      max-height: 46svh;
      padding: 1.05rem 1.05rem 0.95rem;
    }

    :global(html.net-pop-open) .contact-pill {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .net-pop:not([hidden]),
    .net-pop.is-closing,
    .contact-pill:not([hidden]) {
      animation: none;
    }
  }
</style>
