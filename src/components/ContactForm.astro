---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<form class:list={['contact-form', { 'contact-form--compact': compact }]} data-contact-form>
  <div class="form-row">
    <div class="field">
      <label for="contact-name">Prénom ou nom</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required placeholder="Votre nom" />
    </div>
    <div class="field">
      <label for="contact-email">E-mail</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="160" required placeholder="vous@exemple.fr" />
    </div>
  </div>

  <div class="field">
    <label for="contact-subject">Votre recherche</label>
    <input id="contact-subject" name="subject" type="text" maxlength="120" required placeholder="Débuter, reprendre, suivre le projet…" />
  </div>

  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" minlength="10" maxlength="2000" required placeholder="Dites-nous l’information qui vous serait utile."></textarea>
  </div>

  <div class="field field--trap" aria-hidden="true">
    <label for="contact-company">Entreprise</label>
    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <input name="startedAt" type="hidden" value="" data-started-at />

  <label class="consent">
    <input name="consent" type="checkbox" value="yes" required />
    <span>J’accepte l’utilisation de ces informations uniquement pour répondre à ma demande. <a href="/confidentialite/">Voir la confidentialité</a>.</span>
  </label>

  <div class="form-actions">
    <button class="button button--signal" type="submit">Envoyer la demande</button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.4rem;
  }

  .consent {
    display: grid;
    cursor: pointer;
    gap: 0.7rem;
    grid-template-columns: auto 1fr;
    align-items: start;
    max-width: 47rem;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    line-height: 1.5;
  }

  .consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.15rem 0 0;
    accent-color: var(--signal);
  }

  .consent a {
    text-underline-offset: 0.2em;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const startedAt = form.querySelector<HTMLInputElement>('[data-started-at]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (startedAt) startedAt.value = String(Date.now());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (status) {
        status.textContent = 'Envoi en cours…';
        status.dataset.state = 'pending';
      }
      if (submit) submit.disabled = true;

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Impossible d’envoyer la demande.');

        form.reset();
        if (startedAt) startedAt.value = String(Date.now());
        if (status) {
          status.textContent = 'Message reçu. Merci.';
          status.dataset.state = 'success';
        }
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Une erreur est survenue.';
          status.dataset.state = 'error';
        }
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  });
</script>
