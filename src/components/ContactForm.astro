---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<form class:list={['contact-form', { 'contact-form--compact': compact }]} data-contact-form>
  <div class="form-row">
    <div class="field">
      <label for="contact-name">Prénom ou nom</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required placeholder="Votre nom" />
    </div>
    <div class="field">
      <label for="contact-email">E-mail</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="160" required placeholder="vous@exemple.fr" />
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="contact-phone">Téléphone</label>
      <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" inputmode="tel" placeholder="06 12 34 56 78" />
    </div>
    <div class="field">
      <label for="contact-subject">Le cours qui vous intéresse</label>
      <input id="contact-subject" name="subject" type="text" maxlength="120" required placeholder="Éveil, éducative, ados, loisir, compétition, cardio" list="contact-courses" />
      <datalist id="contact-courses">
        <option value="Éveil — baby boxing (3 à 6 ans)"></option>
        <option value="Boxe éducative (7 à 12 ans)"></option>
        <option value="Boxe ados (13 à 17 ans)"></option>
        <option value="Boxe anglaise — loisir"></option>
        <option value="Boxe anglaise — compétition"></option>
        <option value="Cardio boxe"></option>
      </datalist>
    </div>
  </div>

  <div class="field">
    <label for="contact-message">Votre message</label>
    <textarea id="contact-message" name="message" minlength="10" maxlength="2000" required placeholder="Votre âge, votre niveau, et vos disponibilités."></textarea>
  </div>

  {/* Inlett's honeypot. Must reach the API empty; bots fill it. */}
  <div class="field field--trap" aria-hidden="true">
    <label for="contact-gotcha">Entreprise</label>
    <input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <input name="startedAt" type="hidden" value="" data-started-at />

  <label class="consent">
    <input name="consent" type="checkbox" value="yes" required />
    <span>J’accepte d’être recontacté·e par e-mail ou par téléphone au sujet de ma demande. <a href="/confidentialite/">Voir la confidentialité</a>.</span>
  </label>

  <div class="form-actions">
    <button class="button button--signal" type="submit">Envoyer ma demande</button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.4rem;
  }

  .consent {
    display: grid;
    cursor: pointer;
    gap: 0.7rem;
    grid-template-columns: auto 1fr;
    align-items: start;
    max-width: 47rem;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    line-height: 1.5;
  }

  .consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.15rem 0 0;
    accent-color: var(--signal);
  }

  .consent a {
    text-underline-offset: 0.2em;
  }
</style>

<script>
  /**
   * Submits to Inlett.
   *
   * The endpoint is guarded by a proof-of-work challenge: fetch a challenge,
   * find a nonce whose SHA-256 of `challenge:nonce` starts with `difficulty`
   * zeros, and send both with the payload.
   *
   * The hashing uses our own synchronous SHA-256 rather than crypto.subtle.
   * Awaiting a WebCrypto promise per hash costs more in scheduling than in
   * hashing: measured at 15.3s for one difficulty-4 challenge, versus 0.7s
   * synchronously. See src/scripts/pow.ts.
   */
  import { solveChallenge } from '@/scripts/pow';

  const API_URL = 'https://inlett.vercel.app';
  const FORM_ID = '7869b78f-6d80-4d22-b817-4caf15800089';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const startedAt = form.querySelector<HTMLInputElement>('[data-started-at]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (startedAt) startedAt.value = String(Date.now());

    const say = (text: string, state: string) => {
      if (!status) return;
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      /* Anything submitted within 2.5s of load is a bot, not a person. */
      const opened = Number(startedAt?.value);
      if (Number.isFinite(opened) && Date.now() - opened < 2500) {
        say('Envoi trop rapide. Merci de réessayer.', 'error');
        return;
      }

      say('Envoi en cours…', 'pending');
      if (submit) submit.disabled = true;

      try {
        const fields = Object.fromEntries(new FormData(form)) as Record<string, string>;
        delete fields.startedAt;

        const challenge = await fetch(`${API_URL}/api/challenge`).then((response) => {
          if (!response.ok) throw new Error('Service momentanément indisponible. Réessayez.');
          return response.json();
        });

        say('Vérification…', 'pending');
        const nonce = await solveChallenge(challenge.challenge, challenge.difficulty);

        const sent = await fetch(`${API_URL}/api/submit/${FORM_ID}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...fields,
            _lang: 'fr',
            _gotcha: fields._gotcha ?? '',
            pow_challenge: challenge.challenge,
            pow_timestamp: challenge.timestamp,
            pow_nonce: nonce
          })
        });

        if (!sent.ok) {
          const payload = await sent.json().catch(() => ({}));
          throw new Error(payload.error || 'Impossible d’envoyer votre demande.');
        }

        form.reset();
        if (startedAt) startedAt.value = String(Date.now());
        say('Message reçu. Nous vous répondons sous 24 h.', 'success');
      } catch (error) {
        say(error instanceof Error ? error.message : 'Une erreur est survenue.', 'error');
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  });
</script>
