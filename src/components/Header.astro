---
import { NAV } from '@/data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="site-header__inner shell">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" role="presentation">
          <path class="brand__frame" d="M10 8h44v48H10z" />
          <path class="brand__flight" d="M19 49V15h14.5c9 0 13.5 3.3 13.5 9 0 4-2.2 6.6-6.5 8 5.2 1.2 7.8 4.3 7.8 9.2 0 6-4.5 9.8-14.8 9.8H19m0-19h15.2" />
          <circle cx="51" cy="12" r="3" />
        </svg>
      </span>
      <span class="brand__copy">
        <span class="brand__code">43°N · B/01</span>
        <span class="brand__name">Club de boxe<br />Blagnac</span>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span>Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navigation principale">
      <ul>
        {
          NAV.map((item, index) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="site-nav__meta" aria-hidden="true">Blagnac · Toulouse nord-ouest<br />Signal local / Préversion</p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 80;
    top: 0;
    right: 0;
    left: 0;
    height: var(--header-height);
    color: white;
    background: transparent;
  }

  :global(.js) .site-header {
    position: fixed;
  }

  .site-header__inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  /* Contrast is resolved per scroll position by the surface tracker below:
     html[data-tone] tells the header which surface sits under it. This replaces
     mix-blend-mode: difference, which forced the whole document into one
     composited group (blank paint in several rasterizers, and a scroll-perf
     tax on low-end mobile). */
  .site-header {
    --header-ink: var(--paper-bright);
    color: var(--header-ink);
    transition: color 240ms ease;
  }

  :global(html[data-tone='light']) .site-header,
  :global(html[data-tone='signal']) .site-header {
    --header-ink: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .brand {
    z-index: 3;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .brand__mark {
    width: 2.65rem;
    height: 2.65rem;
    display: block;
    flex: 0 0 auto;
  }

  .brand__mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .brand__frame {
    stroke-width: 1.2;
    opacity: 0.78;
  }

  .brand__flight {
    stroke-width: 2.8;
  }

  .brand__mark circle {
    fill: currentColor;
    stroke: none;
  }

  :global(.js) .brand__flight {
    stroke-dasharray: 180;
    stroke-dashoffset: 180;
    animation: mark-draw 900ms 180ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes mark-draw {
    to { stroke-dashoffset: 0; }
  }

  .brand__copy {
    display: grid;
    gap: 0.14rem;
  }

  .brand__code {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .brand__name {
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.035em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .site-nav {
    justify-self: end;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-grid;
    gap: 0.15rem;
    color: inherit;
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.035em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-nav a span {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 400;
    opacity: 0.62;
  }

  .site-nav a::after {
    width: 100%;
    height: 1px;
    content: '';
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__meta,
  .menu-toggle {
    display: none;
  }

  @media (max-width: 58rem) {
    .site-header__inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }

    :global(.js) .menu-toggle {
      z-index: 3;
      display: inline-flex;
      cursor: pointer;
      align-items: center;
      gap: 0.6rem;
      border: 0;
      padding: 0.6rem 0;
      color: inherit;
      background: transparent;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .menu-toggle__icon,
    .menu-toggle__icon::after {
      width: 1.4rem;
      height: 1px;
      display: block;
      content: '';
      background: currentColor;
      transition: transform 180ms ease;
    }

    .menu-toggle__icon::after {
      transform: translateY(0.35rem);
    }

    .menu-toggle[aria-expanded='true'] {
      color: var(--paper-bright);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__icon {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
      transform: rotate(-90deg);
    }

    .site-nav {
      grid-column: 1 / -1;
    }

    :global(.js) .site-nav {
      position: fixed;
      z-index: 1;
      inset: 0;
      min-height: 100dvh;
      visibility: hidden;
      display: grid;
      align-content: end;
      gap: 2rem;
      padding: calc(var(--header-height) + 3rem) var(--page-pad) 2rem;
      color: var(--paper-bright);
      background: var(--ink);
      opacity: 0;
      transform: translateY(-1rem);
      transition:
        opacity 220ms ease,
        transform 220ms ease,
        visibility 220ms;
    }

    :global(.js) .site-nav[data-open='true'] {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .site-nav ul {
      width: 100%;
      display: grid;
      gap: 0;
    }

    .site-nav a {
      grid-template-columns: 2rem 1fr;
      align-items: center;
      gap: 0.75rem;
      padding-block: 0.62rem;
      border-top: 1px solid rgb(255 255 255 / 24%);
      color: var(--paper-bright);
      font-size: clamp(1.75rem, 8vh, 4rem);
      line-height: 0.9;
    }

    .site-nav a span {
      font-size: 0.58rem;
    }

    .site-nav a::after {
      display: none;
    }

    .site-nav__meta {
      display: block;
      color: var(--mist);
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.06em;
      line-height: 1.55;
      text-transform: uppercase;
    }

    :global(.no-js) .site-header {
      position: relative;
      height: auto;
      color: var(--paper-bright);
      background: var(--ink);
    }

    :global(.no-js) .site-header__inner {
      gap: 1rem;
      padding-block: 1rem;
    }

    :global(.no-js) .site-nav {
      width: 100%;
      justify-self: stretch;
    }

    :global(.no-js) .site-nav a {
      font-size: clamp(1.2rem, 7vw, 2rem);
    }
  }

  /* Open menu paints on ink, whatever surface is scrolled under the header. */
  :global(html[data-menu='open']) .site-header {
    --header-ink: var(--paper-bright);
  }

  /* Small handsets: the lockup and the toggle have to share 343px at 375px,
     and 288px at 320px, without either being clipped. */
  @media (max-width: 26rem) {
    .site-header__inner {
      gap: 0.75rem;
    }

    .brand {
      min-width: 0;
      gap: 0.55rem;
    }

    .brand__mark {
      width: 2.15rem;
      height: 2.15rem;
    }

    .brand__code {
      font-size: 0.44rem;
    }

    .brand__name {
      font-size: 0.62rem;
    }

    :global(.js) .menu-toggle {
      gap: 0.45rem;
      font-size: 0.6rem;
    }

    .menu-toggle__icon,
    .menu-toggle__icon::after {
      width: 1.15rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const firstLink = nav?.querySelector<HTMLAnchorElement>('a');

  const root = document.documentElement;

  const closeMenu = (restoreFocus = false) => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.setAttribute('data-open', 'false');
    root.removeAttribute('data-menu');
    document.body.style.removeProperty('overflow');
    if (restoreFocus) toggle?.focus();
  };

  toggle?.addEventListener('click', () => {
    const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(willOpen));
    nav?.setAttribute('data-open', String(willOpen));
    if (willOpen) root.setAttribute('data-menu', 'open');
    else root.removeAttribute('data-menu');
    document.body.style.overflow = willOpen ? 'hidden' : '';
    if (willOpen) window.requestAnimationFrame(() => firstLink?.focus());
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') closeMenu(true);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 928) closeMenu();
  });

  /* ------------------------------------------------------------------ *
   * Surface tracker — resolves header contrast against whatever block
   * is currently underneath it. Replaces mix-blend-mode: difference,
   * which blanked the page in some rasterizers and forced full-document
   * compositing on every scroll frame.
   * ------------------------------------------------------------------ */
  type Tone = 'dark' | 'light' | 'signal';

  /* Tone is measured from the block's real background, not from a marker
     class. Class-matching silently failed on the sub-page heroes, which are
     ink-backgrounded through `.page-hero` and never carried `.surface-dark`
     — the header rendered ink-on-ink and disappeared. Luminance needs no
     one to remember to tag a new section. `surface-signal` stays an explicit
     override: the orange sits mid-luminance but always wants ink on top. */
  const relativeLuminance = (r: number, g: number, b: number) => {
    const channel = (value: number) => {
      const c = value / 255;
      return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
  };

  const toneOf = (el: Element): Tone => {
    if (el.classList.contains('surface-signal')) return 'signal';
    let node: Element | null = el;
    while (node && node !== document.documentElement) {
      const match = getComputedStyle(node)
        .backgroundColor.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:[,/\s]+([\d.]+))?/);
      if (match && (match[4] === undefined || Number(match[4]) > 0.5)) {
        const luminance = relativeLuminance(Number(match[1]), Number(match[2]), Number(match[3]));
        return luminance < 0.4 ? 'dark' : 'light';
      }
      node = node.parentElement;
    }
    return 'light';
  };

  const header = document.querySelector<HTMLElement>('[data-header]');
  let lastTone = root.getAttribute('data-tone') || '';

  /* Rects are read live rather than cached: a cached offset table went stale
     as soon as fonts swapped or a lazy image landed, and the header then
     reported the wrong surface. Eight getBoundingClientRect reads inside one
     rAF is well under budget. */
  const applyTone = () => {
    const probe = (header?.offsetHeight || 76) * 0.55;
    const blocks = document.querySelectorAll('main > *, body > footer');
    let tone: Tone = 'light';
    for (const block of blocks) {
      const rect = block.getBoundingClientRect();
      if (probe >= rect.top && probe < rect.bottom) {
        tone = toneOf(block);
        break;
      }
    }
    if (tone !== lastTone) {
      lastTone = tone;
      root.setAttribute('data-tone', tone);
    }
  };

  let queued = false;
  const schedule = () => {
    if (queued) return;
    queued = true;
    window.requestAnimationFrame(() => {
      applyTone();
      queued = false;
    });
  };

  applyTone();
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  window.addEventListener('load', schedule);
</script>
