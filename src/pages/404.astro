---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page introuvable | Club de Boxe Blagnac–Toulouse';
const description = 'Cette page du projet de club de boxe à Blagnac n’existe pas ou a changé de trajectoire. Revenez à la présentation principale.';
---

<BaseLayout {title} {description} pathname="/404/" noindex>
  <section class="not-found surface-dark">
    <div class="shell">
      <p class="eyebrow eyebrow--signal">Erreur 404</p>
      <h1>Hors du <em>ring.</em></h1>
      <p>Cette page n’existe pas ou a changé de trajectoire.</p>
      <a class="button button--signal" href="/">Retour au projet</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: calc(var(--header-height) + 4rem) 4rem;
  }

  .not-found .shell {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }

  .not-found h1 {
    font-size: clamp(7rem, 24vw, 24rem);
  }

  .not-found h1 em {
    color: var(--flight);
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .not-found p:not(.eyebrow) {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
  }
</style>
