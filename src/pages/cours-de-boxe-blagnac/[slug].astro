---
/**
 * One page per course.
 *
 * Six pages instead of six anchors on a single page. Each one targets its own
 * query cluster — "baby boxing Blagnac" and "cardio boxe Blagnac" are not the
 * same search and should not compete for the same URL.
 *
 * Two sources, never mixed: the course FACTS (ages, contact, rhythm, session
 * steps, body) come from src/data/club.ts; the SEARCH COPY (title, social
 * title, answer-first lead, extra sections, visible FAQ, network lines) comes
 * from src/data/copy.json, written against the keyword registry and checked
 * by the build's keyword contract.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PartnerCta from '@/components/PartnerCta.astro';
import ContactForm from '@/components/ContactForm.astro';
import { CLUB, DISCIPLINES } from '@/data/club';
import { copyFor } from '@/data/copy';
import { courseId, courseNode } from '@/data/schema';

export function getStaticPaths() {
  return DISCIPLINES.map((discipline) => ({
    params: { slug: discipline.slug },
    props: { discipline }
  }));
}

const { discipline } = Astro.props;
const url = `/cours-de-boxe-blagnac/${discipline.slug}/`;
const copy = copyFor(discipline.slug);
if (!copy) throw new Error(`copy.json: no copy for course "${discipline.slug}"`);
const others = DISCIPLINES.filter((d) => d.slug !== discipline.slug);
const largest = discipline.image.widths[discipline.image.widths.length - 1];
---

<BaseLayout
  title={copy.title}
  ogTitle={copy.ogTitle}
  description={copy.description}
  pathname={url}
  topTone="dark"
  schema={courseNode(discipline.slug)}
  mainEntity={courseId(discipline.slug)}
  crumbs={[{ name: 'Cours de boxe à Blagnac', path: '/cours-de-boxe-blagnac/' }, { name: discipline.name, path: url }]}
  network={discipline.slug}
  faq={copy.faq}
  imageAlt={discipline.image.alt}
>
  <header class="page-hero course-page-hero">
    <div class="shell">
      <div class="page-hero__meta">
        <p class="eyebrow eyebrow--signal">{copy.eyebrow}</p>
        <p class="mono">{CLUB.openShort}</p>
      </div>
      <h1>{copy.h1Main} <em>{copy.h1Em}</em></h1>
      <div class="page-hero__bottom">
        <p class="page-hero__lead course-page__summary">{copy.lead}</p>
        <p class="page-hero__note">{copy.note}</p>
      </div>
    </div>
  </header>

  <section class="course-page shell">
    <div class="course-page__grid">
      <div class="prose course-page__body">
        <p>{discipline.body}</p>
        <p>
          Ce cours fait partie des <a href="/cours-de-boxe-blagnac/">six cours du Club de Boxe Blagnac</a>, membre du réseau Boxing Center, au nord-ouest de Toulouse. {CLUB.openLine}
        </p>
      </div>

      <figure class="course-page__media reveal">
        <picture>
          <source
            srcset={discipline.image.widths.map((w) => `/images/${discipline.image.file}-${w}.webp ${w}w`).join(', ')}
            sizes="(max-width: 52rem) 92vw, 46vw"
            type="image/webp"
          />
          <img src={`/images/${discipline.image.file}-${largest}.jpg`} alt={discipline.image.alt} width="1400" height="933" loading="eager" />
        </picture>
      </figure>
    </div>

    <div class="course-page__facts">
      <div><p class="course-page__k">Âges</p><p class="course-page__v">{discipline.ages}</p></div>
      <div><p class="course-page__k">Contact</p><p class="course-page__v">{discipline.contact}</p></div>
      <div><p class="course-page__k">Rythme</p><p class="course-page__v">{discipline.rhythm}</p></div>
      <div><p class="course-page__k">Venir voir</p><p class="course-page__v">Sur demande, matériel prêté</p></div>
    </div>
  </section>

  <section class="course-page-session surface-dark" aria-labelledby="session-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Le déroulé</p>
        <div>
          <h2 id="session-title">Une séance, dans l’ordre.</h2>
          <p class="section-heading__intro">{discipline.rhythm}. L’ordre compte autant que le contenu.</p>
        </div>
      </div>
      <ol class="course-page-session__list sequence-reveal">
        {discipline.session.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  {copy.sections.map((s, i) => (
    <section class="course-extra shell page-copy" aria-labelledby={`extra-${i}`}>
      <div class="page-copy__grid">
        <p class="eyebrow">{s.eyebrow ?? `${String(i + 1).padStart(2, '0')} · ${discipline.name}`}</p>
        <div class="prose">
          <h2 id={`extra-${i}`}>{s.h2}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.bullets && s.bullets.length > 0 && (
            <ul class="course-extra__bullets">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.links && s.links.length > 0 && (
            <p class="course-extra__links">
              {s.links.map((l) => <a class="inline-link" href={l.href}>{l.label} →</a>)}
            </p>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="course-faq shell" aria-labelledby="course-faq-title">
    <div class="section-heading">
      <p class="eyebrow">Questions</p>
      <div><h2 id="course-faq-title">Ce qu’on nous demande sur ce cours.</h2></div>
    </div>
    <div class="course-faq__list">
      {copy.faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="course-page-others shell" aria-labelledby="others-title">
    <div class="section-heading">
      <p class="eyebrow">Les autres cours</p>
      <div><h2 id="others-title">Ce n’est peut-être pas le bon.</h2></div>
    </div>
    <ul class="course-page-others__list sequence-reveal">
      {others.map((d) => (
        <li>
          <a href={`/cours-de-boxe-blagnac/${d.slug}/`}>
            <span class="course-page-others__name">{d.linkLabel}</span>
            <span class="course-page-others__meta">{d.ages}</span>
            <span class="course-page-others__sum">{d.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="signal surface-dark" id="essai">
    <div class="signal__inner shell">
      <div class="signal__heading">
        <p class="eyebrow eyebrow--signal">{discipline.name}</p>
        <h2>Dites-nous ce que vous cherchez.</h2>
        <p>
          Indiquez vos disponibilités et votre niveau. Nous vous répondons sous 24 h avec les créneaux de ce cours, l’adresse et les conditions.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>

  <PartnerCta context={discipline.slug} heading={copy.networkHeading} intro={copy.networkIntro} tone="light" />
</BaseLayout>

<style>
  .course-page-hero h1 {
    max-width: 14ch;
  }

  .course-page {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .course-page__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: start;
  }

  .course-page__body p {
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
  }

  .course-page__media {
    margin: 0;
    overflow: hidden;
  }

  .course-page__media img {
    width: 100%;
    height: clamp(14rem, 26vw, 24rem);
    object-fit: cover;
    filter: grayscale(0.66) contrast(1.1) brightness(0.88);
    transition: transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 500ms ease;
  }

  .course-page__media:hover img {
    transform: scale(1.04);
    filter: grayscale(0.15) brightness(0.98);
  }

  .course-page__facts {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--line);
    border: 1px solid var(--line);
  }

  .course-page__facts > div {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.1rem;
    background: var(--paper);
  }

  .course-page__k {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .course-page__v {
    font-size: 0.95rem;
    font-variation-settings: 'wdth' 90, 'wght' 640;
    line-height: 1.3;
  }

  .course-page-session {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .course-page-session__list {
    display: grid;
    gap: 0;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    border-top: 1px solid var(--line);
  }

  .course-page-session__list li {
    display: grid;
    gap: 1rem;
    grid-template-columns: 2.5rem 1fr;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
  }

  .course-page-session__list li::before {
    content: counter(step, decimal-leading-zero);
    counter-increment: step;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
  }

  .course-page-others {
    padding-bottom: clamp(3.5rem, 7vw, 7rem);
  }

  .course-page-others__list {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .course-page-others__list a {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    height: 100%;
    padding: clamp(1.2rem, 2.2vw, 1.8rem);
    background: var(--paper);
    text-decoration: none;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .course-page-others__list a:hover {
    color: var(--paper-bright);
    background: var(--ink);
  }

  .course-page-others__name {
    font-size: clamp(1.05rem, 1.9vw, 1.4rem);
    font-variation-settings: 'wdth' 88, 'wght' 760;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .course-page-others__meta {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .course-page-others__sum {
    font-size: 0.88rem;
    line-height: 1.45;
    opacity: 0.8;
  }

  @media (max-width: 52rem) {
    .course-page__grid {
      grid-template-columns: 1fr;
    }
  }

  .course-extra {
    padding-block: clamp(3rem, 6vw, 6rem) 0;
  }

  .course-extra h2 {
    max-width: 20ch;
    margin-bottom: 0.7em;
    font-size: clamp(1.9rem, 3.8vw, 3.4rem);
  }

  .course-extra__bullets {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.1em;
  }

  .course-extra__bullets li::marker {
    color: var(--signal);
  }

  .course-extra__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }

  .course-faq {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .course-faq__list {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .course-faq details {
    border-bottom: 1px solid var(--line);
  }

  .course-faq summary {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.2rem 0;
    cursor: pointer;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-variation-settings: 'wdth' 88, 'wght' 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    list-style: none;
  }

  .course-faq summary::-webkit-details-marker {
    display: none;
  }

  .course-faq summary::after {
    content: '+';
    flex: none;
    color: var(--signal);
    font-family: var(--font-mono);
    transition: transform 200ms ease;
  }

  .course-faq details[open] summary::after {
    transform: rotate(45deg);
  }

  .course-faq details p {
    max-width: 64ch;
    padding-bottom: 1.4rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }
</style>
