---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { photoRoom } from '@/data/photos';
import PartnerCta from '@/components/PartnerCta.astro';
import { CLUB, DISCIPLINES, GLOSSARY } from '@/data/club';
import { LEGENDE } from '@/data/seo-map';
import { ROUTES } from '@/data/routes';
import { disciplineList } from '@/data/schema';

for (const l of LEGENDE) {
  if (!ROUTES.some((r) => r.path === l.path)) throw new Error('LEGENDE: no route for ' + l.path);
}

const title = 'Cours de boxe à Blagnac — six cours, de 3 ans à adulte';
const ogTitle = 'Six cours de boxe à Blagnac : lequel est fait pour vous ?';
const description =
  'Nos six cours de boxe anglaise à Blagnac, côte à côte : âge, niveau de contact, rythme de la semaine. De l’éveil dès 3 ans à la compétition, du lundi au samedi.';

---

<BaseLayout
  {title}
  {ogTitle}
  {description}
  pathname="/cours-de-boxe-blagnac/"
  network="hub"
  topTone="dark"
  pageType="CollectionPage"
  withCourses
  withGlossary
  schema={disciplineList()}
  imageAlt="Cours collectif de boxe anglaise, travail au sac de frappe"
>
  <header class="page-hero course-hero">
    <div class="shell">
      <div class="page-hero__meta">
        <p class="eyebrow eyebrow--signal">Cours · Formats · Progression</p>
        <p class="mono">{CLUB.season}</p>
      </div>
      <h1>Cours de boxe <em>à Blagnac</em></h1>
      <div class="page-hero__bottom">
        <p class="page-hero__lead">Six cours, six jours sur sept, de l’éveil à 3 ans au groupe compétition. Ce qui change, c’est l’âge et le niveau de contact — jamais l’exigence technique.</p>
        <p class="page-hero__note">{CLUB.openLine} Écrivez-nous pour le cours qui vous intéresse.</p>
      </div>
    </div>
  </header>

  <section class="course-intro shell page-copy">
    <div class="page-copy__grid">
      <p class="eyebrow">Quel cours choisir</p>
      <div class="prose">
        <p>
          Choisir son cours revient à trancher trois questions : quel âge, quel niveau de contact, et combien de fois par semaine vous pouvez venir. Nos six cours répondent à des intentions différentes ; aucun n’est une version dégradée d’un autre.
        </p>
        <p>
          Un point qui surprend souvent : le contact n’est pas le point de départ. En <strong>éveil</strong> comme en <strong>cardio boxe</strong>, il n’y en a aucun. En <strong>boxe éducative</strong>, il reste en touche légère. En loisir adulte, en touche contrôlée, protections fournies par le club.
        </p>
        <div class="notice">
          <strong>Une première séance ne comporte jamais d’opposition.</strong>
          <p>Quel que soit le cours et quel que soit votre niveau : on regarde d’abord comment vous vous déplacez.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="course-compare shell" aria-labelledby="compare-title">
    <div class="section-heading">
      <p class="eyebrow">En un coup d’œil</p>
      <div>
        <h2 id="compare-title">Les six cours, côte à côte.</h2>
        <p class="section-heading__intro">L’âge, le niveau de contact et le rythme de chaque cours de boxe à Blagnac. Le déroulé de chaque séance suit juste en dessous.</p>
      </div>
    </div>
    <div class="course-compare__scroll" role="region" aria-labelledby="compare-title" tabindex="0">
      <table>
        <caption>Club de Boxe Blagnac · {CLUB.openLine}</caption>
        <thead>
          <tr>
            <th scope="col">Cours</th>
            <th scope="col">Âges</th>
            <th scope="col">Contact</th>
            <th scope="col">Rythme</th>
            <th scope="col">L’idée</th>
          </tr>
        </thead>
        <tbody>
          {DISCIPLINES.map((d) => (
            <tr>
              <th scope="row"><a href={'/cours-de-boxe-blagnac/' + d.slug + '/'}>{d.name}</a></th>
              <td>{d.ages}</td>
              <td>{d.contact}</td>
              <td>{d.rhythm}</td>
              <td>{d.summary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="legende shell" aria-labelledby="legende-title">
    <div class="section-heading">
      <p class="eyebrow">Recherches et réponses</p>
      <div>
        <h2 id="legende-title">Ce que veulent dire les recherches de boxe à Blagnac.</h2>
        <p class="section-heading__intro">Une recherche à gauche, le cours qui y répond à droite.</p>
      </div>
    </div>
    <dl class="legende__list">
      {LEGENDE.map((l) => (
        <div><dt>« {l.query} »</dt><dd>{l.fact} — <a href={l.path}>{l.label}</a></dd></div>
      ))}
    </dl>
    <h2 id="glossaire-title" class="legende__glossary-title">Le vocabulaire de nos cours.</h2>
    <dl class="legende__glossary">
      {GLOSSARY.map((t) => (
        <div id={`terme-${t.slug}`}><dt>{t.name}</dt><dd>{t.description}</dd></div>
      ))}
    </dl>
  </section>

  <section class="course-list surface-dark" aria-labelledby="formats-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Les six formats</p>
        <div>
          <h2 id="formats-title">Ce que contient réellement une séance.</h2>
          <p class="section-heading__intro">Le déroulé de chacun de nos cours, dans l’ordre. Chez nous, l’ordre compte autant que le contenu.</p>
        </div>
      </div>

      <div class="course-list__items">
        {DISCIPLINES.map((d, i) => (
          <article class="course-item reveal" id={d.slug}>
            <div class="course-item__head">
              <p class="course-item__index">{String(i + 1).padStart(2, '0')}</p>
              <h3><a href={`/cours-de-boxe-blagnac/${d.slug}/`}>{d.name}</a></h3>
              <p class="course-item__summary">{d.summary}</p>
              <dl class="course-item__meta">
                <div><dt>Âges</dt><dd>{d.ages}</dd></div>
                <div><dt>Contact</dt><dd>{d.contact}</dd></div>
                <div><dt>Rythme</dt><dd>{d.rhythm}</dd></div>
              </dl>
            </div>
            <div class="course-item__body">
              <figure class="course-item__media">
                <picture>
                  <source
                    srcset={d.image.widths.map((w) => `/images/${d.image.file}-${w}.webp ${w}w`).join(', ')}
                    sizes="(max-width: 52rem) 92vw, 44vw"
                    type="image/webp"
                  />
                  <img
                    src={`/images/${d.image.file}-${d.image.widths[d.image.widths.length - 1]}.jpg`}
                    alt={d.image.alt}
                    width="1400"
                    height="933"
                    loading="lazy"
                  />
                </picture>
              </figure>
              <p>{d.body}</p>
              <ol class="course-item__session">
                {d.session.map((step) => <li>{step}</li>)}
              </ol>
              <p class="course-item__more">
                <a href={`/cours-de-boxe-blagnac/${d.slug}/`}>{d.linkLabel} →</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <figure class="image-frame course-band shell reveal">
      <picture>
        <source srcset="/images/travail-aux-pattes-420.webp 420w, /images/travail-aux-pattes-900.webp 900w, /images/travail-aux-pattes-1400.webp 1400w" sizes="(max-width: 46rem) 92vw, 88vw" type="image/webp" />
        <img src="/images/travail-aux-pattes-1400.jpg" alt="Exercice à deux : l’un frappe, l’autre garde, gants aux poings" width="1400" height="861" loading="lazy" />
      </picture>
      <figcaption><span>Exercice à deux, technique encadrée</span><span>{photoRoom('travail-aux-pattes')}</span></figcaption>
    </figure>
  </section>

  <section class="course-where shell page-copy">
    <div class="page-copy__grid">
      <p class="eyebrow">Venir au club</p>
      <div class="prose">
        <p>
          Nous sommes à Blagnac (31700), au nord-ouest de Toulouse, desservis par le tram T1 et les lignes Tisséo. {CLUB.openLine}
        </p>
        <p>
          {CLUB.seasonNote} Laissez-nous vos coordonnées via le <a href="/acces-contact/#contact">formulaire</a> ou écrivez à <a href={`mailto:${CLUB.email}`}>{CLUB.email}</a> : nous vous envoyons les créneaux et l’adresse exacte.
        </p>
      </div>
    </div>
  </section>

  <PartnerCta
    context="hub"
    heading="Les mêmes cours, ailleurs dans le réseau."
    intro="Si Toulouse est plus pratique pour vous, les autres clubs Boxing Center de l’agglomération publient leurs activités et leurs horaires."
  />
</BaseLayout>

<style>
  .course-hero h1 {
    max-width: 14ch;
  }

  .course-intro,
  .course-where {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .course-list {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .course-list__items {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .course-item {
    display: grid;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    padding-block: clamp(2rem, 4vw, 3.4rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .course-item__index {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .course-item h3 {
    margin-top: 0.7rem;
    font-size: clamp(1.6rem, 3.4vw, 2.9rem);
    font-variation-settings: 'wdth' 84, 'wght' 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .course-item__summary {
    margin-top: 0.6rem;
    color: var(--flight);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-weight: 560;
  }

  .course-item__meta {
    display: grid;
    gap: 0.9rem;
    margin: 1.4rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .course-item__meta div {
    display: grid;
    gap: 0.25rem;
  }

  .course-item__meta dt {
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .course-item__meta dd {
    margin: 0;
    font-size: 0.88rem;
  }

  .course-item__body > p {
    max-width: 62ch;
    color: var(--mist);
    font-size: 1rem;
    line-height: 1.6;
  }

  .course-item__session {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .course-item__session li {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1.8rem 1fr;
    padding-block: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }

  .course-item__session li::before {
    content: counter(step, decimal-leading-zero);
    counter-increment: step;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .course-band {
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  @media (max-width: 52rem) {
    .course-item {
      grid-template-columns: 1fr;
    }
  }

  .course-item__media {
    margin: 0 0 1.4rem;
    overflow: hidden;
  }

  .course-item__media img {
    width: 100%;
    height: clamp(11rem, 20vw, 17rem);
    object-fit: cover;
    filter: grayscale(0.68) contrast(1.1) brightness(0.86);
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 500ms ease;
  }

  .course-item:hover .course-item__media img {
    transform: scale(1.04);
    filter: grayscale(0.18) brightness(0.96);
  }

  .course-item h3 a {
    text-decoration: none;
  }

  .course-item h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .course-item__more {
    margin-top: 1.4rem;
  }

  .course-item__more a {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-underline-offset: 0.3em;
  }

  .course-compare {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .course-compare__scroll {
    margin-top: clamp(2rem, 4vw, 3rem);
    overflow-x: auto;
    border-top: 1px solid var(--line);
    overscroll-behavior-x: contain;
  }

  .course-compare__scroll:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
  }

  .course-compare table {
    width: 100%;
    min-width: 52rem;
    border-collapse: collapse;
  }

  .course-compare caption {
    padding-top: 1rem;
    caption-side: bottom;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    opacity: 0.7;
    text-align: left;
  }

  .course-compare th,
  .course-compare td {
    padding: 1.05rem 1.25rem 1.05rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .course-compare thead th {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    opacity: 0.72;
    text-transform: uppercase;
  }

  .course-compare tbody th {
    min-width: 13rem;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-variation-settings: 'wdth' 84, 'wght' 760;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .course-compare tbody th a {
    text-decoration: none;
  }

  .course-compare tbody th a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .course-compare td {
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .course-compare tbody tr {
    transition: background-color 200ms ease;
  }

  .course-compare tbody tr:hover {
    background: color-mix(in srgb, currentColor 5%, transparent);
  }

  .legende {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .legende__list,
  .legende__glossary {
    display: grid;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: 1px solid var(--line);
  }

  .legende__list > div,
  .legende__glossary > div {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 0.4rem 2rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .legende__list dt {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .legende__glossary dt {
    font-variation-settings: 'wdth' 88, 'wght' 720;
  }

  .legende__list dd,
  .legende__glossary dd {
    margin: 0;
    line-height: 1.5;
  }

  .legende__glossary-title {
    margin-top: clamp(3rem, 6vw, 5rem);
    font-size: clamp(1.9rem, 3.8vw, 3.2rem);
  }

  @media (max-width: 40rem) {
    .legende__list > div,
    .legende__glossary > div {
      grid-template-columns: 1fr;
    }
  }
</style>
