---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PartnerCta from '@/components/PartnerCta.astro';
import { firstSessionSteps } from '@/data/seo';
import { CLUB, GEAR } from '@/data/club';
import { firstSessionHowTo } from '@/data/schema';

const title = 'Séance d’essai gratuite — Club de Boxe Blagnac';
const description =
  'Votre première séance au Club de Boxe Blagnac est gratuite : ce qu’il faut apporter, ce qui va se passer, et pourquoi il n’y a jamais d’opposition le premier jour.';

---

<BaseLayout
  {title}
  {description}
  pathname="/premiere-seance/"
  topTone="dark"
  schema={firstSessionHowTo(firstSessionSteps)}
  speakable={['#steps-title', '.first-steps__list h3']}
  imageAlt="Shadow boxing pendant un entraînement de boxe anglaise"
>
  <header class="page-hero first-hero">
    <div class="shell">
      <div class="page-hero__meta">
        <p class="eyebrow eyebrow--signal">Séance d’essai · Gratuite</p>
        <p class="mono">{CLUB.openShort}</p>
      </div>
      <h1>Votre <em>premier</em> cours est offert.</h1>
      <div class="page-hero__bottom">
        <p class="page-hero__lead">Personne n’arrive en sachant boxer. Chez nous, ce qui se remarque n’est pas votre niveau — c’est si vous écoutez.</p>
        <p class="page-hero__note">Gants et protections prêtés. Aucune opposition à la première séance, quels que soient votre âge et votre condition physique.</p>
      </div>
    </div>
  </header>

  <section class="first-steps shell" aria-labelledby="steps-title">
    <div class="section-heading">
      <p class="eyebrow">01 · Le déroulé</p>
      <div>
        <h2 id="steps-title">Cinq étapes, dans cet ordre.</h2>
        <p class="section-heading__intro">De votre message jusqu’à la fin de la séance. Aucune surprise.</p>
      </div>
    </div>

    <ol class="first-steps__list sequence-reveal">
      {firstSessionSteps.map((step, i) => (
        <li id={`etape-${i + 1}`}>
          <p class="first-steps__n">{step.number}</p>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="first-photo surface-dark">
    <figure class="image-frame shell reveal">
      <picture>
        <source srcset="/images/shadow-boxing-420.webp 420w, /images/shadow-boxing-900.webp 900w, /images/shadow-boxing-1400.webp 1400w" sizes="(max-width: 46rem) 92vw, 88vw" type="image/webp" />
        <img src="/images/shadow-boxing-1400.jpg" alt="Shadow boxing : travail de garde et de déplacement sans partenaire" width="1400" height="933" loading="lazy" />
      </picture>
      <figcaption><span>Shadow boxing</span><span>Le premier geste appris</span></figcaption>
    </figure>
  </section>

  <section class="first-welcome" aria-label="L’accueil">
    <figure>
      <picture>
        <source srcset="/images/accueil-club-420.webp 420w, /images/accueil-club-900.webp 900w, /images/accueil-club-1400.webp 1400w" sizes="100vw" type="image/webp" />
        <img src="/images/accueil-club-1400.jpg" alt="L’entrée et l’accueil du Club de Boxe Blagnac" width="1400" height="887" loading="lazy" />
      </picture>
      <figcaption>L’accueil, où commence votre première visite</figcaption>
    </figure>
  </section>

  <section class="first-gear shell" aria-labelledby="gear-title">
    <div class="section-heading">
      <p class="eyebrow">02 · Le matériel</p>
      <div>
        <h2 id="gear-title">N’achetez rien avant votre premier cours.</h2>
        <p class="section-heading__intro">L’erreur la plus fréquente est d’acheter une paire de gants avant d’avoir mis les pieds dans une salle. Voici l’ordre réel des achats.</p>
      </div>
    </div>

    <ol class="gear-list sequence-reveal">
      {GEAR.map((g) => (
        <li>
          <p class="gear-list__item">{g.item}</p>
          <p class="gear-list__when">{g.when}</p>
          <p class="gear-list__detail">{g.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="first-expect shell page-copy">
    <div class="page-copy__grid">
      <p class="eyebrow">03 · Ce qui va se passer</p>
      <div class="prose">
        <p>
          Nos séances durent une heure trente. Elles commencent par un échauffement — corde, mobilité — qui n’est jamais négociable, puis passent au travail technique : un geste, décomposé, corrigé, répété. Vient ensuite le sac, où la technique doit tenir sous fatigue.
        </p>
        <p>
          Vous serez essoufflé plus vite que vous ne l’imaginez, et c’est normal : la boxe demande une gestion du souffle que ni la course ni la salle de sport n’enseignent. Personne ne le remarquera, parce que tout le monde est passé par là.
        </p>
        <div class="notice">
          <strong>Vous ne serez pas mis en difficulté.</strong>
          <p>Nous ne faisons jamais boxer un débutant contre un pratiquant confirmé. Nos entraîneurs sont sur le tapis à chaque séance, pas assis au bureau.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="book surface-dark" id="reserver">
    <div class="shell book__inner">
      <div>
        <p class="eyebrow eyebrow--signal">Réserver</p>
        <h2>Recevez les créneaux par e-mail.</h2>
        <p class="book__copy">Laissez vos coordonnées : nous vous envoyons les créneaux, l’adresse et les modalités. Réponse sous 24 h.</p>
      </div>
      <div class="book__actions">
        <a class="button button--signal" href="/acces-contact/#contact">Recevoir les informations</a>
        <p class="book__phone"><a href={`mailto:${CLUB.email}`}>{CLUB.email}</a><br /><span>{CLUB.openLine}</span></p>
      </div>
    </div>
  </section>

  <PartnerCta
    eyebrow="Notre réseau"
    heading="Trop loin de Blagnac ?"
    intro="Nous travaillons avec d’autres salles de l’agglomération toulousaine. Si l’une d’elles est plus proche de chez vous, allez la voir de notre part."
  />
</BaseLayout>

<style>
  .first-hero h1 {
    max-width: 11ch;
  }

  .first-steps,
  .first-gear,
  .first-expect {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .first-steps__list {
    display: grid;
    gap: 0;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid currentColor;
  }

  .first-steps__list li {
    display: grid;
    gap: clamp(0.75rem, 3vw, 3rem);
    grid-template-columns: 4rem 1fr;
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--line);
  }

  .first-steps__n {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .first-steps__list h3 {
    font-size: clamp(1.35rem, 2.8vw, 2.2rem);
    font-variation-settings: 'wdth' 86, 'wght' 780;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .first-steps__list h3 + p {
    max-width: 62ch;
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0.86;
  }

  .first-photo {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .gear-list {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    counter-reset: gear;
  }

  .gear-list li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.3rem 1.2rem;
    background: var(--paper);
    counter-increment: gear;
  }

  .gear-list__item {
    font-size: 1.05rem;
    font-variation-settings: 'wdth' 90, 'wght' 700;
    letter-spacing: -0.02em;
  }

  .gear-list__item::before {
    content: '0' counter(gear) ' ';
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-variation-settings: normal;
    letter-spacing: 0.08em;
  }

  .gear-list__when {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gear-list__detail {
    font-size: 0.88rem;
    line-height: 1.5;
    opacity: 0.82;
  }

  @media (max-width: 46rem) {
    .first-steps__list li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .book {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .book__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
  }

  .book__inner h2 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 4.4vw, 4rem);
  }

  .book__copy {
    max-width: 40ch;
    margin-top: 0.9rem;
    color: var(--mist);
  }

  .book__actions {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .book__phone {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.9;
  }

  .book__phone span {
    color: var(--mist);
    font-size: 0.68rem;
  }

  @media (max-width: 52rem) {
    .book__inner {
      grid-template-columns: 1fr;
    }
  }

  .first-welcome figure {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .first-welcome img {
    width: 100%;
    height: clamp(16rem, 40vw, 34rem);
    object-fit: cover;
    filter: grayscale(0.68) contrast(1.08) brightness(0.84);
  }

  .first-welcome figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 1rem 1.2rem;
    color: var(--paper-bright);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
