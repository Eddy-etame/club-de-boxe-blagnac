---
/**
 * Legal notice, modelled on the other Boxing Center network sites: the
 * network is the editor, Vercel is the host.
 *
 * The editor's head office and phone are printed here and nowhere else, and
 * labelled as the EDITOR's — a reader or an answer engine must never take
 * them for the Blagnac club's contact details (the club publishes no address
 * and no phone). Photo credits are generated from the photo registry, so the
 * page names the photographer who actually took each picture.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CLUB } from '@/data/club';
import { NETWORK } from '@/data/network';
import { NETWORK_PHOTOS, PHOTOS, PHOTOGRAPHERS, photoRoom } from '@/data/photos';
import { SITE } from '@/data/site';
import { pageLastModified } from '@/lib/lastmod';

const title = 'Mentions légales — Club de Boxe Blagnac';
const description =
  'Mentions légales du Club de Boxe Blagnac : éditeur Boxing Center, hébergement Vercel, photographes et propriété des images, liens vers les clubs du réseau.';
const host = new URL(SITE.url).host;
const version = pageLastModified('/mentions-legales/').slice(0, 10).split('-').reverse().join('.');
const clubMail = 'mailto:' + CLUB.email;
const editorMail = 'mailto:' + NETWORK.editor.email;
const editorTel = 'tel:' + NETWORK.editor.phoneLink;
const networkHost = NETWORK.url.replace('https://', '').replace(/\/$/, '');
const byPhotographer = [
  ...PHOTOGRAPHERS.map((name) => ({ name, photos: PHOTOS.filter((p) => p.credit === name && p.evidence !== 'publisher') })),
  { name: 'Photothèque ' + NETWORK.name, photos: NETWORK_PHOTOS }
];
/* "d’Axel Derewiany et de Cécile Domenech": French elides "de" before a vowel. */
const byName = (name: string) => (/^[aeiouyéèh]/i.test(name) ? 'd’' : 'de ') + name;
const authors = PHOTOGRAPHERS.map(byName).join(' et ');
---

<BaseLayout {title} ogTitle="Qui édite le site du Club de Boxe Blagnac ?" {description} pathname="/mentions-legales/" topTone="dark">
  <header class="page-hero legal-hero">
    <div class="shell">
      <div class="page-hero__meta">
        <p class="eyebrow eyebrow--signal">Éditeur · Hébergement · Photographies</p>
        <p class="mono">Version du {version}</p>
      </div>
      <h1>Mentions <em>légales.</em></h1>
      <div class="page-hero__bottom">
        <p class="page-hero__lead">Qui publie ce site, qui l’héberge, et qui a pris ses photographies.</p>
      </div>
    </div>
  </header>

  <article class="legal shell page-copy">
    <div class="page-copy__grid">
      <p class="eyebrow">Informations légales</p>
      <div class="prose">
        <h2>Éditeur du site</h2>
        <p>Le site {host} est édité par {NETWORK.name}, réseau de clubs de boxe de l’agglomération toulousaine auquel appartient le {CLUB.name}.</p>
        <dl class="legal__card">
          <div><dt>Dénomination</dt><dd>{NETWORK.editor.legalName}</dd></div>
          <div><dt>Forme juridique</dt><dd>{NETWORK.editor.form}</dd></div>
          <div><dt>SIRET du siège</dt><dd>{NETWORK.editor.siret}</dd></div>
          <div><dt>Immatriculation</dt><dd>{NETWORK.editor.rcs}</dd></div>
          <div><dt>Siège de l’éditeur</dt><dd>{NETWORK.editor.address}</dd></div>
          <div><dt>Téléphone de l’éditeur</dt><dd><a href={editorTel}>{NETWORK.editor.phone}</a></dd></div>
          <div><dt>Courriel de l’éditeur</dt><dd><a href={editorMail}>{NETWORK.editor.email}</a></dd></div>
          <div><dt>Site du réseau</dt><dd><a href={NETWORK.url} rel="noopener">{networkHost}</a></dd></div>
          <div><dt>Directeur de la publication</dt><dd>{NETWORK.editor.director}</dd></div>
        </dl>
        <p class="legal__note">Ces coordonnées sont celles de l’éditeur, le réseau {NETWORK.name}, à Toulouse. Ce ne sont pas celles du {CLUB.name}, que l’on joint par le <a href="/acces-contact/#contact">formulaire de contact</a> ou à <a href={clubMail}>{CLUB.email}</a>.</p>

        <h2>Club de Boxe Blagnac</h2>
        <p>Pour une question sur nos cours, une inscription ou une première venue, écrivez au club : <a href={clubMail}>{CLUB.email}</a>, ou passez par le <a href="/acces-contact/#contact">formulaire de contact</a>. {CLUB.openLine}</p>

        <h2>Hébergement</h2>
        <p>Le site est hébergé par Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, États-Unis — <a href="https://vercel.com" rel="noopener">vercel.com</a>.</p>

        <h2 id="photographies">Photographies</h2>
        <p>Les photographies de ce site ont été prises dans d’autres clubs du réseau {NETWORK.name} ou lors de ses événements : aucune ne montre la salle de Blagnac. Elles sont l’œuvre {authors} ; celles des cours enfants et ados viennent de la photothèque du réseau, publiée sur <a href={NETWORK.url} rel="noopener">{networkHost}</a>. Toute reproduction sans autorisation est interdite.</p>
        {byPhotographer.map((g) => (
          <Fragment>
            <h3 class="legal__h3">{g.name}</h3>
            <ul class="legal__photos">
              {g.photos.map((p) => <li>{p.scene} — {photoRoom(p.file).split(' · ')[0]}</li>)}
            </ul>
          </Fragment>
        ))}

        <h2>Propriété intellectuelle</h2>
        <p>La marque, le logo et les éléments d’identité {NETWORK.name} sont la propriété de leurs titulaires. Les textes de ce site appartiennent à l’éditeur.</p>

        <h2>Liens vers le réseau</h2>
        <p>Ce site renvoie vers les sites des autres clubs {NETWORK.name}. Le contenu de ces sites relève de leurs éditeurs respectifs.</p>

        <h2>Données personnelles</h2>
        <p>Ce que devient une demande envoyée par le formulaire, et comment exercer vos droits : voir la page <a href="/confidentialite/">confidentialité</a>.</p>

        <h2>Signaler une erreur</h2>
        <p>Une information inexacte dans ces mentions, une photographie mal attribuée ? <a href="/acces-contact/#contact">Écrivez-nous</a> : nous corrigeons.</p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-hero h1 {
    max-width: 12ch;
    font-size: clamp(3.7rem, 10vw, 10rem);
  }

  .legal h2 {
    margin-top: 2.4rem;
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .legal h2:first-child {
    margin-top: 0;
  }

  .legal__h3 {
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal__photos {
    display: grid;
    gap: 0.3rem;
    padding-left: 1.1em;
    font-size: 0.98rem;
  }

  .legal__note {
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--signal);
    font-size: 0.98rem;
  }

  .legal__card {
    display: grid;
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--line);
  }

  .legal__card > div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .legal__card dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .legal__card dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .legal__card > div {
      grid-template-columns: 1fr;
    }
  }
</style>
