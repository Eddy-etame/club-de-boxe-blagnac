<script>
  /* Marks the session happening right now, and the next one due, from the
     visitor's local clock. Pure enhancement: without JS the grid is a plain,
     complete, readable schedule. */
  const slots = [...document.querySelectorAll<HTMLElement>('.week__slot')];

  const minutes = (time: string) => {
    const [h, m] = time.split(':').map(Number);
    return h * 60 + m;
  };

  const paint = () => {
    const now = new Date();
    /* JS getDay(): 0 = Sunday. The data uses ISO-8601: 1 = Monday. */
    const today = now.getDay() === 0 ? 7 : now.getDay();
    const nowMinutes = now.getHours() * 60 + now.getMinutes();

    let nextSlot: HTMLElement | null = null;
    let nextDistance = Number.POSITIVE_INFINITY;

    for (const slot of slots) {
      const day = Number(slot.dataset.day);
      const start = minutes(slot.dataset.start || '00:00');
      const end = minutes(slot.dataset.end || '00:00');
      const live = day === today && nowMinutes >= start && nowMinutes < end;

      slot.toggleAttribute('data-live', live);
      slot.removeAttribute('data-next');

      /* Distance forward through the week, wrapping past Sunday. */
      const distance = ((day - today + 7) % 7) * 1440 + start - nowMinutes;
      if (!live && distance > 0 && distance < nextDistance) {
        nextDistance = distance;
        nextSlot = slot;
      }
    }

    if (nextSlot) nextSlot.setAttribute('data-next', 'true');
  };

  if (slots.length) {
    paint();
    window.setInterval(paint, 60_000);
  }
</script>
