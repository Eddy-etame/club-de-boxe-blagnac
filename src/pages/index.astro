---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { DISCIPLINES, GEAR, SEASON, PARTNERS, DISCIPLINE_COUNT } from '@/data/club';
import { LOCATION, ANSWER_TARGETS, AREA_SENTENCE, NEARBY_SENTENCE } from '@/data/seo-map';

const title = 'Club de boxe à Blagnac — cours de boxe anglaise, Toulouse';
const description =
  'Boxe à Blagnac (31700) : boxe anglaise, boxe éducative dès 7 ans, cours ados, loisir, cardio boxe. Âges, déroulé d’un cours, budget et première séance.';

/* Audience blocks. General on purpose: each one answers "is this for me",
   then hands off. Club-level specifics live with the clubs themselves. */
const audiences = [
  {
    n: '01',
    who: 'Les enfants, dès 3 ans',
    text: 'L’éveil commence à 3 ans et n’apprend pas à frapper : parcours de motricité, jeux de réaction, sac mou, aucun contact. La boxe éducative prend le relais vers 7 ans, en touche légère et protections complètes — la coordination et le respect du partenaire bien avant la frappe.'
  },
  {
    n: '02',
    who: 'Les adolescents',
    text: 'Le groupe ados fait le pont vers la boxe adulte. L’intensité monte progressivement, sous un cadre strict sur les protections. C’est là que se décide, sans pression, l’orientation loisir ou compétition.'
  },
  {
    n: '03',
    who: 'Les adultes débutants',
    text: 'On peut commencer la boxe anglaise à 25 comme à 55 ans, sans condition physique préalable. Le premier trimestre est consacré à la garde, au déplacement et à la respiration — pas à l’opposition.'
  },
  {
    n: '04',
    who: 'Les femmes',
    text: 'La pratique féminine a fortement progressé en France depuis les années 2000. Dans la plupart des clubs du secteur, hommes et femmes s’entraînent sur les mêmes créneaux, sans cours séparé et sans niveau imposé.'
  },
  {
    n: '05',
    who: 'Ceux qui ne veulent pas de contact',
    text: 'Le cardio boxe reprend les déplacements, les enchaînements et le travail au sac, sans aucune opposition. C’est une entrée fréquente vers le cours loisir, et une pratique complète en soi.'
  }
];

const faqAnswers = [
  `La boxe se pratique à ${LOCATION.city} et dans le secteur nord-ouest de Toulouse, accessible en tram T1 et en bus Tisséo depuis ${NEARBY_SENTENCE}.`,
  'La plupart des clubs du secteur proposent une séance d’essai avant toute adhésion, avec gants et protections prêtés. Les modalités et les montants se demandent directement au club.',
  'Dès 3 ans. Les séances d’éveil travaillent la motricité et la réaction sans aucun contact ; la boxe éducative prend le relais vers 7 ans en touche légère, et l’opposition plus soutenue arrive à l’adolescence.',
  'La boxe éducative se pratique en touche légère sans recherche de puissance, quand la boxe anglaise adulte autorise une opposition contrôlée avec protections.'
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ANSWER_TARGETS.slice(0, 4).map((question, index) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: faqAnswers[index] }
  }))
};
---

<BaseLayout
  {title}
  {description}
  pathname="/"
  topTone="dark"
  pageType="AboutPage"
  imageAlt="Boxeuse en garde pendant un entraînement de boxe anglaise"
  schema={faqSchema}
  preloadImage={{
    href: '/images/garde-boxeuse-960.webp',
    srcset: '/images/garde-boxeuse-480.webp 480w, /images/garde-boxeuse-960.webp 960w, /images/garde-boxeuse-1600.webp 1600w',
    sizes: '100vw'
  }}
>
  <section class="home-hero surface-dark">
    <div class="home-hero__media" aria-hidden="true">
      <picture>
        <source srcset="/images/garde-boxeuse-480.webp 480w, /images/garde-boxeuse-960.webp 960w, /images/garde-boxeuse-1600.webp 1600w" sizes="100vw" type="image/webp" />
        <img src="/images/garde-boxeuse-1600.jpg" alt="" width="1600" height="1067" fetchpriority="high" />
      </picture>
    </div>
    <div class="home-hero__shade" aria-hidden="true"></div>

    <div class="home-hero__inner shell">
      <div class="home-hero__top">
        <p class="eyebrow eyebrow--signal home-hero__eyebrow">Boxe anglaise · {LOCATION.city} {LOCATION.postalCode} · {SEASON.label}</p>
        <p class="home-hero__coordinates" aria-label={`Boxe à ${AREA_SENTENCE}`}>
          <span>{LOCATION.city.toUpperCase()} / TOULOUSE NORD-OUEST / {LOCATION.department.toUpperCase()}</span>
        </p>
      </div>

      <h1>
        <span class="hero-line"><span class="hero-line__text">Club de boxe</span></span>
        <span class="hero-line hero-line--offset"><span class="hero-line__text"><em>à</em> Blagnac</span></span>
      </h1>

      <div class="home-hero__bottom">
        <p class="home-hero__lead hero-enter hero-enter--lead">
          Boxe anglaise, éveil dès 3 ans, boxe éducative, cours ados, loisir adulte et cardio boxe. Tout ce qu’il faut savoir avant votre première séance.
        </p>
        <div class="home-hero__actions hero-enter hero-enter--actions">
          <a class="button button--signal" href="#essai">Préparer ma première séance</a>
          <span><a href="/cours-de-boxe-blagnac/">Découvrir les {DISCIPLINE_COUNT} disciplines →</a></span>
          <span class="home-hero__credit">Photo © Axel Derewiany</span>
        </div>
      </div>
    </div>
  </section>

  <div class="status-strip" role="region" aria-label="La boxe à Blagnac en bref">
    <div class="status-strip__track">
      {[0, 1].map(() => (
        <div class="status-strip__item" aria-hidden="true">
          <span>Boxe anglaise Blagnac</span>
          <span>Éveil dès 3 ans</span>
          <span>Cours ados</span>
          <span>Loisir adulte</span>
          <span>Cardio boxe</span>
          <span>Compétition</span>
          <span>Toulouse nord-ouest</span>
        </div>
      ))}
    </div>
  </div>

  <section class="manifesto shell" aria-labelledby="intro-title">
    <div class="section-heading position-heading sequence-reveal">
      <p class="eyebrow">01 · La boxe à Blagnac</p>
      <div>
        <h2 id="intro-title">Un sport de patience avant d’être un sport de combat.</h2>
      </div>
    </div>

    <div class="position-console sequence-reveal" aria-label="Repères">
      <p><span>01 / Disciplines</span><strong>{DISCIPLINE_COUNT} formats</strong><span class="position-console__ready">Dès 3 ans</span></p>
      <p><span>02 / Secteur</span><strong>{LOCATION.city} {LOCATION.postalCode}</strong><span class="position-console__ready">Tram T1</span></p>
      <p><span>03 / Première fois</span><strong>Séance d’essai</strong><span class="position-console__ready">Matériel prêté</span></p>
    </div>

    <div class="manifesto__grid">
      <p class="manifesto__statement reveal reveal--left">
        On ne commence pas la boxe en frappant. On commence en apprenant à tenir sa garde, à se déplacer, et à respirer quand tout dit de retenir son souffle.
      </p>
      <div class="prose reveal reveal--right">
        <p>
          Chercher un <strong>club de boxe à Blagnac</strong> pose toujours les mêmes questions : quelle discipline, à partir de quel âge, avec quel matériel, pour quel budget. Cette page y répond dans l’ordre, sans jargon et sans vous demander de choisir avant d’avoir compris.
        </p>
        <p>
          {LOCATION.city} se situe {LOCATION.position}, en {LOCATION.department}. Le secteur est desservi par le tram T1 et les lignes Tisséo, ce qui met les <strong>cours de boxe anglaise</strong> à portée de {NEARBY_SENTENCE}. Les quartiers d’{LOCATION.districts[0]}, du {LOCATION.districts[1]} et du {LOCATION.districts[2]} concentrent l’essentiel des équipements sportifs de la commune.
        </p>
      </div>
    </div>
  </section>

  <section class="visual-index surface-dark" aria-labelledby="disciplines-title">
    <div class="visual-index__heading shell">
      <p class="eyebrow">02 · Les disciplines</p>
      <h2 id="disciplines-title">Six façons<br /><em>de boxer.</em></h2>
      <p>De l’éveil à 3 ans au groupe compétition, chaque format répond à une intention différente. Aucune n’est un préalable à l’autre.</p>
    </div>

    <div class="disciplines shell">
      {DISCIPLINES.map((d, i) => (
        <article class="discipline reveal" id={d.slug}>
          <p class="discipline__index">{String(i + 1).padStart(2, '0')}</p>
          <div class="discipline__body">
            <h3>{d.name}</h3>
            <p class="discipline__summary">{d.summary}</p>
            <p class="discipline__text">{d.body}</p>
            <dl class="discipline__meta">
              <div><dt>Âges</dt><dd>{d.ages}</dd></div>
              <div><dt>Contact</dt><dd>{d.contact}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>

    <figure class="image-frame band-image shell reveal">
      <picture>
        <source srcset="/images/cours-collectif-sacs-480.webp 480w, /images/cours-collectif-sacs-960.webp 960w, /images/cours-collectif-sacs-1600.webp 1600w" sizes="(max-width: 46rem) 92vw, 88vw" type="image/webp" />
        <img src="/images/cours-collectif-sacs-1600.jpg" alt="Cours collectif de boxe à Blagnac : travail au sac de frappe en salle" width="1600" height="1067" loading="lazy" />
      </picture>
      <figcaption><span>Travail au sac en cours collectif</span><span>Boxe anglaise</span></figcaption>
    </figure>
  </section>

  <section class="rounds shell" aria-labelledby="rounds-title">
    <div class="section-heading">
      <p class="eyebrow">03 · Un cours, minute par minute</p>
      <div>
        <h2 id="rounds-title">Ce qui se passe entre l’arrivée et le retour au calme.</h2>
        <p class="section-heading__intro">La structure est à peu près la même partout, quel que soit l’âge ou le niveau : un cours de boxe dure généralement une heure à une heure trente.</p>
      </div>
    </div>

    <ol class="rounds__list sequence-reveal">
      <li>
        <span>01</span>
        <h3>Échauffement</h3>
        <p>Corde, mobilité articulaire, montée en température. Quinze minutes environ, jamais négociables.</p>
      </li>
      <li>
        <span>02</span>
        <h3>Technique</h3>
        <p>Au miroir puis aux pattes d’ours. Un geste, décomposé, corrigé, répété jusqu’à ce qu’il tienne.</p>
      </li>
      <li>
        <span>03</span>
        <h3>Sac et déplacements</h3>
        <p>La technique sous fatigue. C’est ici que se construit la condition physique propre à la boxe.</p>
      </li>
      <li>
        <span>04</span>
        <h3>Opposition</h3>
        <p>En touche contrôlée, avec protections, et seulement quand le cadre le permet. Jamais dès le premier jour.</p>
      </li>
    </ol>
  </section>

  <section class="audiences surface-signal" aria-labelledby="audiences-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">04 · Pour qui</p>
        <div>
          <h2 id="audiences-title">La boxe n’a pas de public type.</h2>
          <p class="section-heading__intro">Enfants dès 3 ans, adolescents, adultes débutants, femmes, pratiquants sans contact : cinq entrées possibles dans le même sport.</p>
        </div>
      </div>

      <div class="audiences__grid sequence-reveal">
        {audiences.map((a) => (
          <article class="audience">
            <p class="audience__n">{a.n}</p>
            <h3>{a.who}</h3>
            <p>{a.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="practical shell" aria-labelledby="practical-title">
    <div class="section-heading">
      <p class="eyebrow">05 · Le matériel</p>
      <div>
        <h2 id="practical-title">N’achetez rien tout de suite.</h2>
        <p class="section-heading__intro">L’erreur la plus fréquente du débutant est d’acheter une paire de gants avant son premier cours. Voici l’ordre réel des achats.</p>
      </div>
    </div>

    <div class="gear reveal">
      <ol>
        {GEAR.map((g) => (
          <li>
            <p class="gear__item">{g.item}</p>
            <p class="gear__when">{g.when}</p>
            <p class="gear__detail">{g.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="local surface-dark" aria-labelledby="local-title">
    <div class="local__media" aria-hidden="true">
      <picture>
        <source srcset="/images/salle-de-boxe-480.webp 480w, /images/salle-de-boxe-960.webp 960w, /images/salle-de-boxe-1600.webp 1600w" sizes="100vw" type="image/webp" />
        <img src="/images/salle-de-boxe-1600.jpg" alt="" width="1600" height="919" loading="lazy" />
      </picture>
    </div>
    <div class="local__inner shell">
      <div class="section-heading">
        <p class="eyebrow eyebrow--signal">06 · S’y rendre</p>
        <div>
          <h2 id="local-title">Blagnac, et tout le nord-ouest toulousain.</h2>
          <p class="section-heading__intro">{AREA_SENTENCE}. Le secteur est l’un des mieux desservis de la métropole.</p>
        </div>
      </div>

      <div class="local__grid">
        <ul class="local__transport reveal">
          {LOCATION.transport.map((t) => (
            <li><strong>{t.mode}</strong><span>{t.detail}</span></li>
          ))}
        </ul>
        <div class="prose reveal">
          <p>
            Une <strong>salle de boxe à Blagnac</strong> attire au-delà de la commune : {NEARBY_SENTENCE} sont à moins de vingt minutes, et le tram met le centre de Toulouse à portée directe. C’est ce qui explique la densité de clubs sur le secteur <strong>Toulouse nord-ouest</strong>.
          </p>
          <p>
            Repères utiles pour situer les équipements : {LOCATION.landmarks.join(', ')}. {SEASON.closures}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="partners shell" aria-labelledby="partners-title">
    <div class="section-heading">
      <p class="eyebrow">07 · Où s’inscrire</p>
      <div>
        <h2 id="partners-title">Les horaires et l’encadrement sont chez les clubs.</h2>
        <p class="section-heading__intro">Cette page explique la pratique. Pour un planning, un tarif, un nom d’entraîneur ou une inscription, c’est au club de répondre.</p>
      </div>
    </div>

    <div class="partners__list sequence-reveal">
      {PARTNERS.map((club) => (
        <article class="partner">
          <div class="partner__head">
            <p class="partner__short">{club.short}</p>
            <h3><a href={club.url} rel="noopener">{club.name}</a></h3>
            <p class="partner__area">{club.area}</p>
          </div>
          <div class="partner__body">
            <p>{club.covers}</p>
            <ul class="partner__links">
              {club.links.map((l) => (
                <li><a href={l.url} rel="noopener">{l.label} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
            <a class="button button--signal partner__cta" href={club.url} rel="noopener">Voir le club</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="signal surface-dark" id="essai">
    <div class="signal__inner shell">
      <div class="signal__heading">
        <p class="eyebrow eyebrow--signal">Première séance</p>
        <h2>Le premier cours ne s’achète pas.</h2>
        <p>
          Presque tous les clubs du secteur proposent une séance d’essai. Venez en tenue de sport, avec une bouteille d’eau : gants et protections sont prêtés. Une question sur la pratique, l’âge d’entrée ou le déroulé d’un cours ? Écrivez-nous.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="closing-image" aria-label="Clôture visuelle">
    <picture>
      <source srcset="/images/frappe-au-sac-480.webp 480w, /images/frappe-au-sac-960.webp 960w, /images/frappe-au-sac-1600.webp 1600w" sizes="100vw" type="image/webp" />
      <img src="/images/frappe-au-sac-1600.jpg" alt="Entraînement de boxe au sac de frappe dans une salle du nord-ouest toulousain" width="1600" height="959" loading="lazy" />
    </picture>
    <p class="closing-image__title reveal" aria-hidden="true">Blagnac<br /><em>garde haute.</em></p>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: max(48rem, 100svh);
    overflow: hidden;
  }

  /* The curtain's RESTING state is retracted. It used to rest at scaleX(1) —
     an opaque ink rectangle over the whole hero — and only opened via an
     animation gated on `.page-ready`. Whenever that class was late or never
     arrived (throttled rAF in a background tab, deferred module not yet run),
     the hero stayed behind a solid black panel. Every hero animation below
     follows the same rule now: rest = final state, entry = animation with
     `both` fill, gated on `.js` alone. */
  .home-hero::after {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    content: '';
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: right center;
  }

  :global(.js) .home-hero::after {
    animation: hero-curtain 820ms 80ms cubic-bezier(0.76, 0, 0.24, 1) both;
  }

  @keyframes hero-curtain {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }

  .home-hero__media,
  .home-hero__shade {
    position: absolute;
    inset: 0;
  }

  .home-hero__media picture,
  .home-hero__media img {
    width: 100%;
    height: 100%;
  }

  .home-hero__media img {
    object-fit: contain;
    object-position: center;
    filter: grayscale(0.78) contrast(1.14) brightness(0.72);
    transform: scale(1.015);
    animation: hero-settle 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes hero-settle {
    from { transform: scale(1.08); }
    to { transform: scale(1.015); }
  }

  .home-hero__shade {
    background:
      linear-gradient(180deg, rgb(10 10 8 / 50%) 0%, transparent 30%),
      linear-gradient(0deg, rgb(10 10 8 / 85%) 0%, transparent 58%),
      linear-gradient(90deg, rgb(10 10 8 / 28%), transparent 55%);
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    min-height: max(48rem, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-height) + 2.5rem);
    padding-bottom: clamp(1.6rem, 3vw, 3rem);
  }

  .home-hero__top,
  .home-hero__bottom {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr auto;
  }

  .home-hero__coordinates {
    min-width: min(25rem, 40vw);
    overflow: hidden;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
  }

  .home-hero__coordinates span {
    width: 100%;
    display: block;
    overflow: hidden;
    border-right: 1px solid var(--flight);
    margin-left: auto;
    white-space: nowrap;
  }

  :global(.js) .home-hero__coordinates span {
    animation:
      hero-type 1.3s 1.05s steps(46, end) both,
      caret-blink 520ms 1.05s step-end 5;
  }

  @keyframes hero-type {
    from { width: 0; }
    to { width: 100%; }
  }

  @keyframes caret-blink {
    50% { border-color: transparent; }
  }

  :global(.js) .home-hero__eyebrow {
    animation: hero-meta-in 620ms 780ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes hero-meta-in {
    from {
      opacity: 0;
      transform: translateX(calc(min(2.5rem, 6vw) * -1));
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* The floor has to let "à BLAGNAC" — the widest line — fit inside
     (100vw - 2 × page-pad - offset). A 4.5rem floor was wider than a 375px
     viewport could hold, so the final C was clipped. Sized off vw only,
     with the offset folded into the same budget. */
  .home-hero h1 {
    margin-block: auto 2rem;
    font-size: clamp(6rem, 13vw, 15rem);
    line-height: 0.75;
    text-transform: uppercase;
  }

  .home-hero h1 .hero-line {
    display: block;
    overflow: clip;
  }

  .home-hero h1 .hero-line--offset {
    padding-left: min(6vw, 10rem);
  }

  .hero-line__text {
    display: block;
  }

  :global(.js) .hero-line__text {
    animation: hero-line-in 860ms 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.js) .hero-line--offset .hero-line__text {
    animation-name: hero-line-in-offset;
    animation-delay: 590ms;
  }

  @keyframes hero-line-in {
    from {
      opacity: 0;
      transform: translate3d(-7vw, 115%, 0) rotate(1.5deg);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0);
    }
  }

  @keyframes hero-line-in-offset {
    from {
      opacity: 0;
      transform: translate3d(7vw, 115%, 0) rotate(-1.5deg);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0);
    }
  }

  .home-hero h1 em {
    color: var(--flight);
    font-family: Georgia, serif;
    font-size: 0.72em;
    font-weight: 400;
    text-transform: lowercase;
  }

  .home-hero__lead {
    max-width: 50rem;
    align-self: end;
    font-size: clamp(1.4rem, 2.8vw, 2.65rem);
    font-weight: 520;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  :global(.js) .hero-enter {
    animation: hero-enter 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  :global(.js) .hero-enter--lead {
    animation-delay: 900ms;
  }

  :global(.js) .hero-enter--actions {
    animation-delay: 1.04s;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-hero__actions {
    display: grid;
    gap: 0.9rem;
    justify-items: stretch;
    align-self: end;
  }

  .home-hero__actions span {
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .home-hero__credit {
    color: var(--paper-bright) !important;
    opacity: 0.72;
  }

  .manifesto {
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .position-heading h2 {
    max-width: 11ch;
  }

  /* overflow: clip contains the ±3rem entry slide of the rows below. Without
     it those transforms pushed content 48px past the viewport, where
     body{overflow-x:clip} silently cut it instead of revealing it. */
  .position-console {
    overflow: clip;
    margin-bottom: clamp(3rem, 7vw, 7rem);
    border-block: 1px solid currentColor;
  }

  .position-console p {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 1.2fr) auto;
    align-items: center;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1vw, 0.78rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .position-console p:last-child {
    border-bottom: 0;
  }

  .position-console strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 2.4rem);
    font-variation-settings: 'wdth' 86, 'wght' 760;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .position-console p > span:last-child {
    padding: 0.32rem 0.55rem;
    border: 1px solid currentColor;
  }

  .position-console__ready {
    color: var(--ink);
    background: var(--flight);
  }

  :global(.js) .position-console p {
    opacity: 0;
    transform: translateX(-3rem);
    transition:
      opacity 500ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .position-console p:nth-child(2) {
    transform: translateX(3rem);
    transition-delay: 100ms;
  }

  :global(.js) .position-console p:nth-child(3) {
    transition-delay: 200ms;
  }

  :global(.js) .position-console.is-visible p {
    opacity: 1;
    transform: translateX(0);
  }

  .manifesto__grid {
    display: grid;
    gap: clamp(2rem, 8vw, 9rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: start;
  }

  .manifesto__statement {
    max-width: 20ch;
    font-size: clamp(2.2rem, 5.2vw, 5.7rem);
    font-weight: 680;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .manifesto__statement strong {
    color: var(--signal);
    font-weight: inherit;
  }

  .visual-index {
    padding-block: clamp(5rem, 9vw, 9rem);
    overflow: hidden;
  }

  .visual-index__heading {
    display: grid;
    gap: 2rem;
    grid-template-columns: 0.4fr 1.15fr 0.45fr;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 7rem);
  }

  .visual-index__heading h2 {
    font-size: clamp(3.6rem, 9vw, 9.5rem);
  }

  .visual-index__heading h2 em {
    color: var(--flight);
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .visual-index__heading > p:last-child {
    color: var(--mist);
    font-size: 0.92rem;
  }

  .visual-index__gallery {
    display: grid;
    gap: var(--page-pad);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .visual-index__gallery .image-frame img {
    object-fit: contain;
  }

  .visual-index__main {
    aspect-ratio: 3 / 2;
    grid-column: 2 / span 6;
  }

  .visual-index__side {
    aspect-ratio: 3 / 2;
    grid-column: 9 / span 3;
    margin-top: 14vw;
  }

  .visual-index__wide {
    aspect-ratio: 6720 / 4131;
    grid-column: 5 / span 7;
    margin-top: -4vw;
  }

  .rounds {
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .rounds__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
    list-style: none;
  }

  .rounds__list li {
    min-height: 26rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
  }

  .rounds__list li:last-child {
    border-right: 0;
  }

  .rounds__list span {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .rounds__list h3 {
    margin-top: auto;
    font-size: clamp(2.2rem, 4vw, 4.4rem);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .rounds__list p {
    max-width: 18rem;
    font-size: 0.94rem;
  }

  .search-intent {
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  .search-intent__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 6rem);
    grid-template-columns: 0.4fr 1.05fr 0.55fr;
  }

  .search-intent__title {
    max-width: 13ch;
    font-size: clamp(3rem, 7vw, 7.4rem);
    font-weight: 760;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  .search-intent__copy,
  .search-intent__links {
    grid-column: 2;
  }

  .search-intent__links {
    display: grid;
    border-top: 1px solid currentColor;
  }

  .search-intent__links a {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto;
    padding-block: 1rem;
    border-bottom: 1px solid currentColor;
    font-weight: 650;
    text-decoration: none;
  }

  .search-intent__links a span {
    transition: transform 180ms ease;
  }

  .search-intent__links a:hover span {
    transform: translateX(0.4rem);
  }

  .signal {
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  .signal__inner {
    display: grid;
    gap: clamp(3rem, 8vw, 9rem);
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
  }

  .signal__heading {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .signal__heading h2 {
    max-width: 11ch;
    font-size: clamp(3rem, 6.5vw, 7rem);
  }

  .signal__heading > p:last-child {
    max-width: 30rem;
    color: var(--mist);
  }

  .closing-image {
    position: relative;
    height: min(70rem, 88vh);
    overflow: hidden;
    color: var(--paper-bright);
    background: var(--ink);
  }

  .closing-image picture,
  .closing-image img {
    width: 100%;
    height: 100%;
  }

  .closing-image img {
    object-fit: contain;
    filter: grayscale(0.8) contrast(1.12) brightness(0.65);
  }

  .closing-image p {
    position: absolute;
    right: var(--page-pad);
    top: calc(var(--header-height) + var(--page-pad));
    bottom: auto;
    left: var(--page-pad);
    font-size: clamp(4rem, 14vw, 14rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.72;
    text-transform: uppercase;
  }

  .closing-image em {
    color: var(--flight);
    font-family: Georgia, serif;
    font-weight: 400;
    text-transform: none;
  }

  @media (max-width: 64rem) {
    .visual-index__heading,
    .search-intent__inner {
      grid-template-columns: 0.4fr 1.6fr;
    }

    .visual-index__heading > p:last-child {
      grid-column: 2;
    }

    .search-intent__copy,
    .search-intent__links {
      grid-column: 2;
    }

    .rounds__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .rounds__list li:nth-child(2) {
      border-right: 0;
    }

    .rounds__list li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 52rem) {
    .home-hero__top,
    .home-hero__bottom,
    .manifesto__grid,
    .signal__inner {
      grid-template-columns: 1fr;
    }

    .home-hero__coordinates {
      display: none;
    }

    .home-hero h1 span:nth-child(2) {
      padding-left: 0;
    }

    .visual-index__heading,
    .search-intent__inner {
      grid-template-columns: 1fr;
    }

    .visual-index__heading > p:last-child,
    .search-intent__copy,
    .search-intent__links {
      grid-column: 1;
    }

    .visual-index__main {
      grid-column: 1 / span 8;
    }

    .visual-index__side {
      grid-column: 9 / span 4;
      margin-top: 25vw;
    }

    .visual-index__wide {
      grid-column: 3 / span 10;
      margin-top: -2vw;
    }
  }

  @media (max-width: 36rem) {
    /* A 3:2 photo letterboxed by object-fit:contain inside a portrait hero
       painted 375×250 in an 824px box — 574px of dead black under a floating
       strip of image. The photo now owns a deliberate band and fills it, and
       the type block sits on ink beneath it. The photographer credit stays
       rendered as text in .home-hero__actions, so attribution survives the
       crop. */
    .home-hero__media,
    .home-hero__shade {
      inset: 0 0 auto 0;
      height: 54svh;
    }

    .home-hero__media img {
      object-fit: cover;
      object-position: center 24%;
    }

    .home-hero__shade {
      background:
        linear-gradient(180deg, rgb(10 10 8 / 52%) 0%, transparent 34%),
        linear-gradient(0deg, var(--ink) 1%, rgb(10 10 8 / 22%) 54%, transparent 80%);
    }

    /* 22vw made "à BLAGNAC" 341px wide inside 288px of usable width at 320px,
       so the final C was cut. 16.2vw is the widest ratio that keeps the
       longest line inside the page-pad budget at 320/360/375/390/414, and the
       6rem ceiling hands over continuously to the base rule's 6rem floor at
       the 36rem boundary — no size jump across the breakpoint. */
    .home-hero h1 {
      font-size: clamp(2.4rem, 16.2vw, 6rem);
      line-height: 0.78;
    }

    .rounds__list {
      grid-template-columns: 1fr;
    }

    .rounds__list li,
    .rounds__list li:nth-child(2) {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .rounds__list h3 {
      margin-top: 4rem;
      writing-mode: horizontal-tb;
      transform: none;
    }

    .visual-index__main {
      grid-column: 1 / span 10;
    }

    .visual-index__side {
      grid-column: 8 / span 5;
      margin-top: -15vw;
    }

    .visual-index__wide {
      grid-column: 2 / span 11;
      margin-top: 0;
    }
  }

  /* ---------------------------------------------------------------- *
   * La semaine — the weekly schedule grid.
   * Motion here carries information rather than decoration: the slot
   * running right now is marked from the visitor's own clock, so the
   * page answers "is there a session on tonight" without a click.
   * ---------------------------------------------------------------- */
  .week {
    padding-block: clamp(4.5rem, 9vw, 9rem);
  }

  .week__grid {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(6, 1fr);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid currentColor;
  }

  .week__day {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 0.9rem 1.6rem;
    border-right: 1px solid var(--line);
  }

  .week__day:last-child {
    border-right: 0;
  }

  .week__day-name {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .week__day-name span {
    color: var(--signal);
  }

  .week__day ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .week__slot {
    display: grid;
    gap: 0.28rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--line);
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .week__slot:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }

  .week__time {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .week__time i {
    font-style: normal;
    opacity: 0.5;
  }

  .week__course {
    font-size: 0.86rem;
    font-variation-settings: 'wdth' 88, 'wght' 680;
    line-height: 1.05;
  }

  .week__room {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    opacity: 0.62;
    text-transform: uppercase;
  }

  /* Set by the script below, from the visitor's own clock. */
  .week__slot[data-live='true'] {
    border-color: transparent;
    color: var(--ink);
    background: var(--flight);
  }

  .week__slot[data-live='true'] .week__room {
    opacity: 0.78;
  }

  .week__slot[data-live='true'] .week__time::after {
    width: 0.4rem;
    height: 0.4rem;
    display: inline-block;
    margin-left: 0.35rem;
    content: '';
    border-radius: 50%;
    background: currentColor;
    animation: week-pulse 1.6s ease-in-out infinite;
  }

  .week__slot[data-next='true'] {
    border-color: var(--signal);
  }

  @keyframes week-pulse {
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .week__slot[data-live='true'] .week__time::after {
      animation: none;
    }
  }

  .week__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .week__foot p {
    max-width: 42ch;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    opacity: 0.72;
  }

  .signal__direct {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    line-height: 1.9;
  }

  .signal__direct a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 64rem) {
    .week__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .week__day:nth-child(3n) {
      border-right: 0;
    }

    .week__day:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 42rem) {
    .week__grid {
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .week__day {
      padding-inline: 0;
      border-right: 0;
      border-top: 1px solid var(--line);
    }

    .week__day:nth-child(-n + 3) {
      border-bottom: 0;
    }

    .week__day ul {
      grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    }

    .week__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ---------------------------------------------------------------- *
   * Disciplines — the SEO spine of the page. Long-form, indexable,
   * one anchor per discipline so other pages and outbound links can
   * target them directly.
   * ---------------------------------------------------------------- */
  .disciplines {
    display: grid;
    gap: 0;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
  }

  .discipline {
    display: grid;
    gap: clamp(1rem, 4vw, 3.5rem);
    grid-template-columns: 4.5rem 1fr;
    padding-block: clamp(2rem, 4vw, 3.4rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .discipline__index {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .discipline__body {
    display: grid;
    gap: 0.85rem;
    max-width: 62ch;
  }

  .discipline h3 {
    font-size: clamp(1.6rem, 3.4vw, 2.9rem);
    font-variation-settings: 'wdth' 84, 'wght' 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .discipline__summary {
    color: var(--flight);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 560;
  }

  .discipline__text {
    color: var(--mist);
    font-size: 1rem;
    line-height: 1.6;
  }

  .discipline__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 0.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .discipline__meta div {
    display: grid;
    gap: 0.25rem;
  }

  .discipline__meta dt {
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .discipline__meta dd {
    margin: 0;
    font-size: 0.88rem;
  }

  .band-image {
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  /* ---- Pour qui ---- */
  .audiences {
    padding-block: clamp(4.5rem, 9vw, 9rem);
  }

  .audiences__grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .audience {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.4rem, 2.4vw, 2.1rem);
    background: var(--signal);
  }

  .audience__n {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    opacity: 0.72;
  }

  .audience h3 {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-variation-settings: 'wdth' 88, 'wght' 760;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .audience p:last-child {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* ---- Budget et matériel ---- */
  .practical {
    padding-block: clamp(4.5rem, 9vw, 9rem);
  }

  .cost {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid currentColor;
  }

  .cost__row {
    display: grid;
    gap: 0.6rem 2rem;
    grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1.2fr);
    align-items: baseline;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .cost__label {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-variation-settings: 'wdth' 90, 'wght' 640;
    letter-spacing: -0.02em;
  }

  .cost__range {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .cost__note {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
    opacity: 0.7;
  }

  .gear {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .gear h3 {
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    font-variation-settings: 'wdth' 88, 'wght' 740;
    letter-spacing: -0.03em;
  }

  .gear ol {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    counter-reset: gear;
  }

  .gear li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.3rem 1.2rem;
    background: var(--paper);
    counter-increment: gear;
  }

  .gear__item {
    font-size: 1.05rem;
    font-variation-settings: 'wdth' 90, 'wght' 700;
    letter-spacing: -0.02em;
  }

  .gear__item::before {
    content: '0' counter(gear) ' ';
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-variation-settings: normal;
    letter-spacing: 0.08em;
  }

  .gear__when {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gear__detail {
    font-size: 0.88rem;
    line-height: 1.5;
    opacity: 0.82;
  }

  /* ---- S'y rendre ---- */
  .local {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 9vw, 9rem);
  }

  .local__media {
    position: absolute;
    inset: 0;
  }

  .local__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: grayscale(0.86) brightness(0.34) contrast(1.15);
  }

  .local__inner {
    position: relative;
    z-index: 1;
  }

  .local__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .local__transport {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .local__transport li {
    display: grid;
    gap: 0.3rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .local__transport strong {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .local__transport span {
    color: var(--mist);
