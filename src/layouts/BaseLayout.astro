---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import FlightLine from '@/components/FlightLine.astro';
import NetworkPopup from '@/components/NetworkPopup.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE, absoluteUrl } from '@/data/site';
import { LOCATION } from '@/data/seo-map';
import { pageLastModified } from '@/lib/lastmod';
import { buildGraph } from '@/data/schema';
import { ROUTES, ogId } from '@/data/routes';

interface Props {
  title: string;
  /** Social-card title. Defaults to <title>; set a more conversational line. */
  ogTitle?: string;
  description: string;
  pathname?: string;
  image?: string;
  imageAlt?: string;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'FAQPage' | 'CollectionPage';
  /** Extra nodes merged into this page's @graph (HowTo, ItemList…). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Emit the Course + glossary reference layer on this page. */
  withCourses?: boolean;
  /** Emit the FAQ question nodes on this page. */
  withFaq?: boolean;
  /** Breadcrumb trail below Accueil, for pages deeper than one level. */
  crumbs?: { name: string; path: string }[];
  /** @id of the entity this page is about (a Course, for instance). */
  mainEntity?: string;
  /** Network context: picks the slide-in card and the contact pill. */
  network?: string;
  noindex?: boolean;
  /** Tone of the first block on the page, so the header renders with correct
   *  contrast before the surface tracker runs. */
  topTone?: 'dark' | 'light' | 'signal';
  preloadImage?: {
    href: string;
    srcset: string;
    sizes: string;
  };
}

const {
  title,
  ogTitle = title,
  description,
  pathname = Astro.url.pathname,
  image,
  imageAlt = 'Boxeurs en mouvement sur un ring',
  pageType = 'WebPage',
  schema,
  noindex = false,
  topTone = 'light',
  withCourses = false,
  withFaq = false,
  crumbs,
  mainEntity,
  network,
  preloadImage
} = Astro.props;

const canonical = absoluteUrl(pathname);
/* Each page ships its own social card (src/pages/og/[page].jpg.ts). */
const route = ROUTES.find((r) => r.path === pathname);
const socialImage = absoluteUrl(image ?? (route ? '/og/' + ogId(route.path) + '.jpg' : SITE.socialImage));
/* One trail for the visible breadcrumb AND the BreadcrumbList. */
const trail = crumbs ?? (route && route.path !== '/' ? [{ name: route.label, path: route.path }] : undefined);
const robots = SITE.indexable && !noindex
  ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
  : 'noindex,nofollow,noarchive,nosnippet';
const modified = pageLastModified(pathname);

/* One consolidated @graph per page. See src/data/schema.ts for why the nodes
   cross-reference by @id and why every `sameAs` was resolved against the live
   Wikipedia API rather than written from memory. */
const graph = buildGraph({
  pathname,
  title,
  description,
  pageType,
  withCourses,
  withFaq,
  crumbs: trail,
  mainEntity,
  extra: schema ? (Array.isArray(schema) ? schema : [schema]) : []
});
---

<!doctype html>
<html lang={SITE.lang} id="top" class="no-js" data-tone={topTone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* `js` puts every .reveal at opacity:0 and hands the job of showing it
         to the IntersectionObserver in the deferred module below. If that
         module is blocked, errors, or is still in flight, the page stays
         permanently blank — so an unconditional failsafe reveals everything
         if the observer has not claimed the page in time. The module clears
         this timer the moment it runs. */
      (function () {
        var root = document.documentElement;
        root.classList.replace('no-js', 'js');
        window.__revealFailsafe = setTimeout(function () {
          root.classList.add('reveal-failsafe');
        }, 1500);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Language targeting. One locale today, but declaring it (plus x-default)
        stops search engines guessing, and makes adding a second trivial. */}
    <link rel="alternate" hreflang="fr-FR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    {/* Region and commune only. No coordinates: without a published street
        address, a point on a map would assert a location we do not give. */}
    <meta name="geo.region" content={`FR-${LOCATION.departmentCode}`} />
    <meta name="geo.placename" content={`${LOCATION.city}, ${LOCATION.department}`} />

    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />

    {/* Ownership verification for Google Search Console and Bing Webmaster Tools.
        Set the tokens as Vercel env vars; nothing renders until they exist. */}
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}

    <meta name="author" content="Eddy Etame Etame" />
    <meta name="technical-lead" content="Eddy Etame Etame" />
    <meta name="publisher" content={SITE.name} />
    <meta name="rating" content="general" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e8e5dc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141411" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Informations pour agents" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Contexte complet pour agents" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="AI policy" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:updated_time" content={modified} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Photographer credit travels with the page, not only in the visible UI. */}
    <meta name="image:credit" content="Axel Derewiany" />
    <meta name="copyright" content="Photographies © Axel Derewiany" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <FlightLine />
    <main id="contenu">
      {trail && <Breadcrumbs trail={trail} />}
      <slot />
    </main>
    <Footer />
    {network && <NetworkPopup context={network} />}

    <script>
      const reveals = document.querySelectorAll<HTMLElement>('.reveal, .sequence-reveal');
      /* The observer is live, so the head script's blank-page failsafe is no
         longer needed. */
      clearTimeout((window as unknown as { __revealFailsafe?: number }).__revealFailsafe);
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        reveals.forEach((node) => observer.observe(node));
      } else {
        reveals.forEach((node) => node.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  /* Anchors the breadcrumb, which sits in the hero's top margin. */
  main {
    position: relative;
  }
</style>
